<Window
    x:Class="WanKePos.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WanKePos.WinUI.Views"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    mc:Ignorable="d"
    Title="万客隆 POS 收银系统">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="AppTitleBarRow" Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义沉浸式标题栏 (集成状态徽章与置顶开关，与 WinUI 3 原生系统控制按钮对齐) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/pos_icon.ico" Width="18" Height="18" VerticalAlignment="Center"/>
                <TextBlock Text="万客隆 POS" 
                           FontSize="13" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="10" 
                        Padding="8,1" 
                        VerticalAlignment="Center">
                    <TextBlock Text="v0.1.0" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Border>
            </StackPanel>

            <!-- 中间空白可拖拽区域 -->
            <Border Grid.Column="1" Background="Transparent"/>

            <!-- 右侧微件区 (动态自适应原生最小化/最大化/关闭三键区域) -->
            <StackPanel x:Name="TitleBarWidgetsPanel" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,152,0">
                <!-- 门店胶囊徽章 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="8,3" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE707;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="StoreNameTextBlock" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 同步状态胶囊徽章 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="8,3" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xEB55;" FontSize="11" Foreground="{ThemeResource SuccessTextBrush}"/>
                        <TextBlock x:Name="SyncStatusTextBlock" 
                                   FontSize="11" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- 置顶开关胶囊 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="12" 
                        Padding="6,1,8,1" 
                        VerticalAlignment="Center">
                    <CheckBox x:Name="AlwaysOnTopCheckBox" 
                              Content="置顶" 
                              IsChecked="True" 
                              FontSize="11" 
                              MinHeight="0"
                              MinWidth="0"
                              Padding="4,0,0,0"
                              Checked="AlwaysOnTopCheckBox_Checked" 
                              Unchecked="AlwaysOnTopCheckBox_Unchecked"
                              ToolTipService.ToolTip="保持软件窗口始终在浏览器与其他窗口上方"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 主导航栏 (PowerToys 风格，直通底部，完全一体化) -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneTitle=""
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="210"
                        CompactPaneLength="48"
                        Background="Transparent"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="收银结算" Tag="Cashier" ToolTipService.ToolTip="收银结算台 (F1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7BF;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="商品管理" Tag="Products" ToolTipService.ToolTip="商品管理 (F2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="会员管理" Tag="Members" ToolTipService.ToolTip="会员管理 (F3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="销售流水" Tag="Orders" ToolTipService.ToolTip="销售记录流水 (F4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="采购进货" Tag="Purchase" ToolTipService.ToolTip="采购进货单与入库 (F5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="系统设置" Tag="Settings" ToolTipService.ToolTip="系统设置与更新 (F6)">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource/>
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;"/>
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Background="Transparent"/>
        </NavigationView>
    </Grid>
</Window>
