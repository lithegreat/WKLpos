<Window
    x:Class="WanKePos.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WanKePos.WinUI.Views"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="万客隆 POS 收银系统">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- 主导航栏 -->
        <NavigationView x:Name="NavView"
                        Grid.Row="0"
                        PaneTitle="万客隆 POS"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="190"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="收银台 (F1)" Tag="Cashier" Icon="Shop"/>
                <NavigationViewItem Content="商品管理 (F2)" Tag="Products" Icon="BrowsePhotos"/>
                <NavigationViewItem Content="会员管理 (F3)" Tag="Members" Icon="People"/>
                <NavigationViewItem Content="销售记录 (F4)" Tag="Orders" Icon="Document"/>
                <NavigationViewItem Content="采购进货 (F5)" Tag="Purchase" Icon="AllApps"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="系统设置 (F6)" Tag="Settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🏪" FontSize="13"/>
                    <TextBlock x:Name="StoreNameTextBlock" 
                               FontSize="12" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock x:Name="SyncStatusTextBlock" 
                           Grid.Column="1" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <!-- 主题切换下拉菜单 -->
                    <DropDownButton x:Name="ThemeDropDownButton" 
                                    Padding="8,2" 
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="快速切换主题：跟随系统 / 浅色 / 黑暗模式">
                        <DropDownButton.Content>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon x:Name="ThemeButtonIcon" Glyph="&#xE790;" FontSize="12"/>
                                <TextBlock x:Name="ThemeButtonText" Text="跟随系统" FontSize="12"/>
                            </StackPanel>
                        </DropDownButton.Content>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Top">
                                <MenuFlyoutItem Text="💻 跟随系统 (默认)" Tag="Default" Click="ThemeMenuItem_Click"/>
                                <MenuFlyoutItem Text="☀️ 浅色模式" Tag="Light" Click="ThemeMenuItem_Click"/>
                                <MenuFlyoutItem Text="🌙 黑暗模式" Tag="Dark" Click="ThemeMenuItem_Click"/>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <CheckBox x:Name="AlwaysOnTopCheckBox" 
                              Content="窗口置顶" 
                              IsChecked="True" 
                              FontSize="12" 
                              Checked="AlwaysOnTopCheckBox_Checked" 
                              Unchecked="AlwaysOnTopCheckBox_Unchecked"
                              ToolTipService.ToolTip="保持软件窗口始终在浏览器与其他窗口上方"/>
                    <TextBlock x:Name="ClockTextBlock" 
                               FontSize="12" 
                               VerticalAlignment="Center" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
