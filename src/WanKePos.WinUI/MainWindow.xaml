<Window
    x:Class="WanKePos.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:WanKePos.WinUI.Views"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="万客隆 POS 收银系统 (WinUI 3 现代架构版)">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- 主导航栏 -->
        <NavigationView x:Name="NavView"
                        Grid.Row="0"
                        PaneTitle="万客隆 POS"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        OpenPaneLength="190"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="收银台 (F1)" Tag="Cashier" Icon="Shop"/>
                <NavigationViewItem Content="商品管理 (F2)" Tag="Products" Icon="BrowsePhotos"/>
                <NavigationViewItem Content="会员管理 (F3)" Tag="Members" Icon="People"/>
                <NavigationViewItem Content="销售记录 (F4)" Tag="Orders" Icon="Document"/>
                <NavigationViewItem Content="采购进货 (F5)" Tag="Purchase" Icon="AllApps"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="系统设置 (F6)" Tag="Settings" Icon="Setting"/>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>

        <!-- 底部状态栏 -->
        <Border Grid.Row="1" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="🏪" FontSize="13"/>
                    <TextBlock Text="{x:Bind MainViewModel.CurrentStoreName, Mode=OneWay}" 
                               FontSize="12" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" 
                           Text="{x:Bind MainViewModel.SyncStatusText, Mode=OneWay}" 
                           FontSize="12" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <TextBlock Grid.Column="2" 
                           Text="{x:Bind MainViewModel.CurrentTime, Mode=OneWay}" 
                           FontSize="12" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
