<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.PurchaseOrderDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:WanKePos.WinUI.Converters"
    mc:Ignorable="d"
    Title="采购单详情"
    CloseButtonText="关闭"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
    SecondaryButtonClick="ContentDialog_SecondaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">840</x:Double>
    </ContentDialog.Resources>

    <Grid Width="800" RowSpacing="14" Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <!-- 单据信息与汇总卡片 -->
            <RowDefinition Height="Auto"/>
            <!-- 明细表格表头 -->
            <RowDefinition Height="Auto"/>
            <!-- 明细表格数据项 (支持滚动) -->
            <RowDefinition Height="*"/>
            <!-- 底部汇总指示条 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第一行：单据总览信息卡片 -->
        <Border Grid.Row="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16,12">
            <StackPanel Spacing="10">
                <!-- 单号与状态 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="采购单号:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OrderNoTextBlock" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="CopyOrderNoButton" Click="CopyOrderNoButton_Click" Height="26" Width="26" Padding="0" CornerRadius="4" ToolTipService.ToolTip="复制采购单号">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- 修改此单 (仅待入库单据可见) -->
                        <Button x:Name="EditOrderButton" 
                                Click="EditOrderButton_Click" 
                                Height="28" 
                                Padding="8,0" 
                                CornerRadius="4" 
                                ToolTipService.ToolTip="在制单工作台修改此采购单">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="修改此单" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 状态标签胶囊 -->
                        <Border x:Name="StatusBadgeBorder" 
                                CornerRadius="4" 
                                Padding="10,4" 
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTextBlock" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 两列详细信息 -->
                <Grid ColumnSpacing="24" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 供货商 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="供货商:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SupplierTextBlock" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- 制单时间 -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="制单时间:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="CreatedAtTextBlock" FontSize="12"/>
                    </StackPanel>

                    <!-- 入库时间 (若已入库) -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="入库时间:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ReceivedAtTextBlock" FontSize="12"/>
                    </StackPanel>

                    <!-- 备注 -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="备　　注:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="RemarkTextBlock" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 第二行：采购明细表头 -->
        <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1,1,1,0" 
                CornerRadius="6,6,0,0" 
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>    <!-- 序号 -->
                    <ColumnDefinition Width="*"/>     <!-- 商品名称 -->
                    <ColumnDefinition Width="135"/>   <!-- 条码 -->
                    <ColumnDefinition Width="80"/>    <!-- 规格/单位 -->
                    <ColumnDefinition Width="85"/>    <!-- 进货单价 -->
                    <ColumnDefinition Width="80"/>    <!-- 采购数量 -->
                    <ColumnDefinition Width="95"/>    <!-- 小计金额 -->
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="商品名称" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="条码" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="规格/单位" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="进货单价" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="采购数量" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="小计金额" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 第三行：采购明细数据列表 -->
        <Border Grid.Row="2"
                MaxHeight="340"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,6,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView x:Name="ItemsListView" 
                      SelectionMode="None" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="36"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                BorderThickness="0,0,0,1" 
                                Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>    <!-- 序号 -->
                                    <ColumnDefinition Width="*"/>     <!-- 商品名称 -->
                                    <ColumnDefinition Width="135"/>   <!-- 条码 -->
                                    <ColumnDefinition Width="80"/>    <!-- 规格/单位 -->
                                    <ColumnDefinition Width="85"/>    <!-- 进货单价 -->
                                    <ColumnDefinition Width="80"/>    <!-- 采购数量 -->
                                    <ColumnDefinition Width="95"/>    <!-- 小计金额 -->
                                </Grid.ColumnDefinitions>

                                <!-- 序号 -->
                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>

                                <!-- 商品名称 -->
                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <!-- 条码 -->
                                <Border Grid.Column="2" 
                                        Background="{ThemeResource PillNeutralBackgroundBrush}" 
                                        CornerRadius="3" 
                                        Padding="5,1" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="{ThemeResource PillNeutralForegroundBrush}"/>
                                </Border>

                                <!-- 规格/单位 -->
                                <TextBlock Grid.Column="3" Text="{Binding DisplaySpecAndUnit}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>

                                <!-- 进货单价 -->
                                <TextBlock Grid.Column="4" Text="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 采购数量 -->
                                <TextBlock Grid.Column="5" Text="{Binding Quantity}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                <!-- 小计金额 -->
                                <TextBlock Grid.Column="6" Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 第四行：底部汇总与统计条 -->
        <Border Grid.Row="3" 
                Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="商品品类:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TotalItemsCountTextBlock" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="种" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="采购总数:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TotalQuantityTextBlock" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="采购总额:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="TotalAmountTextBlock" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
