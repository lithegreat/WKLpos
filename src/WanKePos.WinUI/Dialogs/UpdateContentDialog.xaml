<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.UpdateContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="发现新版本更新"
    PrimaryButtonText="立即下载并安装"
    CloseButtonText="稍后提醒"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="450" Width="460">
        <StackPanel Spacing="14" Margin="0,6,12,6">
            
            <!-- 版本概览卡片 -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="最新版本:" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionTextBlock" Text="v1.0.1" FontSize="16" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="CurrentVersionTextBlock" Text="(当前版本: v1.0.0)" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="安装包大小:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SizeTextBlock" Text="38.5 MB" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="发布时间:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DateTextBlock" Text="2026-09-03" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 更新日志说明 -->
            <StackPanel Spacing="6">
                <TextBlock Text="更新内容与修复日志:" FontWeight="SemiBold" FontSize="14"/>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12" MaxHeight="180">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesTextBlock" TextWrapping="Wrap" FontSize="13" LineHeight="20"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- 下载进度条区 (初始折叠) -->
            <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                <Grid>
                    <TextBlock x:Name="ProgressStatusText" Text="正在下载新版本安装程序..." FontSize="13"/>
                    <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                </Grid>
                <ProgressBar x:Name="DownloadProgressBar" Value="0" Maximum="100" Height="8"/>
            </StackPanel>

            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorTextBlock" Foreground="{ThemeResource CriticalTextBrush}" FontSize="12" Visibility="Collapsed" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
