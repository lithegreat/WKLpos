<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.AddMemberContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="办理新会员"
    PrimaryButtonText="确认开卡"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Width="460">
        <StackPanel Spacing="12" Margin="0,6,12,6">
            
            <!-- 手机号 (核心必填) -->
            <StackPanel Spacing="4">
                <TextBlock Text="会员手机号 *" FontWeight="SemiBold"/>
                <TextBox x:Name="PhoneTextBox" PlaceholderText="输入11位手机号 (必填)"/>
            </StackPanel>

            <!-- 姓名与会员号 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="会员姓名 *" FontWeight="SemiBold"/>
                    <TextBox x:Name="NameTextBox" PlaceholderText="例如：王女士 / 李先生"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="会员卡号" FontWeight="SemiBold"/>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MemberNoTextBox" Grid.Column="0" PlaceholderText="自动生成或输入"/>
                        <Button Grid.Column="1" Click="GenerateMemberNoButton_Click" Height="32" Width="36" Padding="0" ToolTipService.ToolTip="自动生成卡号">
                            <FontIcon Glyph="&#xE735;" FontSize="11"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 性别与生日 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="会员性别"/>
                    <ComboBox x:Name="GenderComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="女士"/>
                        <ComboBoxItem Content="先生"/>
                        <ComboBoxItem Content="保密"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="会员生日"/>
                    <DatePicker x:Name="BirthdayPicker" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Grid>

            <!-- 储值余额与积分初始化 -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="开卡储值余额 (元)" FontWeight="SemiBold" Foreground="{ThemeResource SuccessTextBrush}"/>
                        <TextBox x:Name="BalanceTextBox" Text="0.00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="初始积分" FontWeight="SemiBold" Foreground="{ThemeResource PriceHighlightBrush}"/>
                        <TextBox x:Name="PointsTextBox" Text="0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 会员身份与专属导购 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="会员身份 / 等级"/>
                    <ComboBox x:Name="IdentityComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="普通会员"/>
                        <ComboBoxItem Content="黄金会员"/>
                        <ComboBoxItem Content="钻石VIP"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="专属导购 / 发型师"/>
                    <TextBox x:Name="GuideNameTextBox" PlaceholderText="例如：Andy老师"/>
                </StackPanel>
            </Grid>

            <!-- 家庭住址 -->
            <StackPanel Spacing="4">
                <TextBlock Text="家庭住址 / 备注"/>
                <TextBox x:Name="AddressTextBox" PlaceholderText="选填"/>
            </StackPanel>

            <!-- 错误提示 -->
            <TextBlock x:Name="ErrorTextBlock" Foreground="{ThemeResource CriticalTextBrush}" FontSize="12" Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
