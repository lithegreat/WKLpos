<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.AddProductContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="新增商品档案"
    PrimaryButtonText="保存并上架"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520" Width="480">
        <StackPanel Spacing="12" Margin="0,6,12,6">
            
            <!-- 条码 -->
            <StackPanel Spacing="4">
                <TextBlock Text="商品条码 / 简码 *" FontWeight="SemiBold"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BarcodeTextBox" Grid.Column="0" PlaceholderText="支持扫码枪直接扫入或手动输入"/>
                    <Button Grid.Column="1" Click="GenerateBarcodeButton_Click" Height="32">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE735;" FontSize="11"/>
                            <TextBlock Text="自动生成" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- 商品名称 -->
            <StackPanel Spacing="4">
                <TextBlock Text="商品名称 *" FontWeight="SemiBold"/>
                <TextBox x:Name="NameTextBox" PlaceholderText="例如：施华蔻柔顺修护洗发露 500ml"/>
            </StackPanel>

            <!-- 店内品类与商品类型 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="店内分类" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CategoryComboBox" IsEditable="True" HorizontalAlignment="Stretch" PlaceholderText="选择或输入品类"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="售卖方式" FontWeight="SemiBold"/>
                    <ComboBox x:Name="SaleMethodComboBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="按件售卖"/>
                        <ComboBoxItem Content="称重售卖"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- 价格设定 -->
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid RowSpacing="10" ColumnSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <TextBlock Text="门店零售价 (元) *" FontWeight="SemiBold" Foreground="{ThemeResource PriceHighlightBrush}"/>
                        <TextBox x:Name="RetailPriceTextBox" PlaceholderText="0.00"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                        <TextBlock Text="平均进货价 (元)" FontWeight="SemiBold"/>
                        <TextBox x:Name="CostPriceTextBox" PlaceholderText="0.00"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4">
                        <TextBlock Text="门店会员价 (元)" FontWeight="SemiBold" Foreground="{ThemeResource SuccessTextBrush}"/>
                        <TextBox x:Name="MemberPriceTextBox" PlaceholderText="选填"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                        <TextBlock Text="初始库存" FontWeight="SemiBold"/>
                        <TextBox x:Name="StockTextBox" Text="100"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                        <TextBlock Text="销售单位" FontWeight="SemiBold"/>
                        <TextBox x:Name="SaleUnitTextBox" Text="瓶"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4">
                        <TextBlock Text="规格/净含量" FontWeight="SemiBold"/>
                        <TextBox x:Name="SpecTextBox" PlaceholderText="如: 500ml"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 供应商与品牌 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="供应商名称"/>
                    <TextBox x:Name="SupplierTextBox" PlaceholderText="例如：广州博美美发用品"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="商品品牌"/>
                    <TextBox x:Name="BrandTextBox" PlaceholderText="例如：施华蔻"/>
                </StackPanel>
            </Grid>

            <!-- 错误提示文本 -->
            <TextBlock x:Name="ErrorTextBlock" Foreground="{ThemeResource CriticalTextBrush}" FontSize="12" Visibility="Collapsed"/>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
