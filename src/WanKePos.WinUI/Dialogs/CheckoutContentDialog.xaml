<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.CheckoutContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="现金结算确认"
    PrimaryButtonText="确认结算"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <StackPanel Spacing="16" Width="360" Margin="0,10,0,0">
        <!-- 应付金额 -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16">
            <StackPanel HorizontalAlignment="Center" Spacing="4">
                <TextBlock Text="应付金额" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="PayableText" FontSize="32" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 实收金额 -->
        <StackPanel Spacing="6">
            <TextBlock Text="实收金额 (元):" FontSize="14" FontWeight="SemiBold"/>
            <TextBox x:Name="PaidAmountTextBox" 
                     FontSize="22" 
                     Height="48" 
                     HorizontalContentAlignment="Center"
                     TextChanged="PaidAmountTextBox_TextChanged"/>
        </StackPanel>

        <!-- 找零显示 -->
        <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                CornerRadius="8" 
                Padding="12">
            <Grid>
                <TextBlock Text="找零金额:" FontSize="15" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock x:Name="ChangeText" Text="¥0.00" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource SuccessTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</ContentDialog>
