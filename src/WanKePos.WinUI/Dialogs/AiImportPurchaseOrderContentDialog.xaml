<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.AiImportPurchaseOrderContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WanKePos.Domain.Models"
    mc:Ignorable="d"
    Title="AI 手写采购单智能识别与导入"
    PrimaryButtonText="导入到待制采购单"
    CloseButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620" Width="720">
        <StackPanel Spacing="12" Margin="0,6,12,6">

            <!-- 顶部操作辅助工具条 -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="请直接粘贴 (Ctrl+V) AI 识别结果，或选择 .json/.yaml 文件：" 
                           FontSize="13" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Grid.Column="1" 
                        Click="CopyPromptButton_Click" 
                        ToolTipService.ToolTip="复制专用的手写单据 OCR 提示词，发给 ChatGPT/Claude/Gemini/DeepSeek">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                        <TextBlock Text="复制 AI 提示词" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" 
                        Click="SelectFileButton_Click" 
                        ToolTipService.ToolTip="支持 .json, .yaml, .yml 或 .txt 文件">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                        <TextBlock Text="选择文件" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" 
                        Click="ClearInputButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                        <TextBlock Text="清空" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 提示词复制成功徽标 -->
            <InfoBar x:Name="PromptCopiedInfoBar" 
                     Severity="Success" 
                     Title="提示词已复制到剪贴板！" 
                     Message="您可直接在 ChatGPT/Claude/Gemini/DeepSeek 中粘贴提示词并附带手写单照片发送。" 
                     IsOpen="False"/>

            <!-- 文本输入区 -->
            <TextBox x:Name="InputTextBox" 
                     AcceptsReturn="True" 
                     TextWrapping="Wrap" 
                     Height="140" 
                     PlaceholderText="在此直接粘贴 AI 返回的 JSON 或 YAML 文本（支持包含 ```json 代码块）..." 
                     FontFamily="Consolas, Cascadia Code, Courier New" 
                     FontSize="12"
                     TextChanged="InputTextBox_TextChanged"/>

            <!-- 解析操作栏 -->
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="ParseButton" 
                        Style="{StaticResource AccentButtonStyle}" 
                        Click="ParseButton_Click" 
                        Height="34" 
                        Padding="16,0"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE721;" FontSize="12"/>
                        <TextBlock Text="智能解析并核对" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <TextBlock x:Name="StatusMessageTextBlock" 
                           VerticalAlignment="Center" 
                           FontSize="13" 
                           Foreground="{ThemeResource CriticalTextBrush}" 
                           Visibility="Collapsed"/>
            </StackPanel>

            <!-- 识别结果预览区 (成功解析后展示) -->
            <StackPanel x:Name="PreviewPanel" Spacing="10" Visibility="Collapsed">
                
                <!-- 单据头部信息卡片 -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12,10">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="供货商:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="SupplierTextBlock" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="制单日期:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="OrderDateTextBlock"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="备注:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="RemarkTextBlock" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="明细品类数:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="ItemsCountTextBlock" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="采购总件数:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TotalQuantityTextBlock" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="采购总金额:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TotalAmountTextBlock" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 算术校验提示 -->
                <InfoBar x:Name="ArithmeticInfoBar" 
                         Severity="Informational" 
                         IsOpen="False" 
                         IsClosable="False"/>

                <!-- 商品明细表头 -->
                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1,1,1,0" 
                        CornerRadius="6,6,0,0" 
                        Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="商品名称" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="条码 / 规格" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="单位" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="进价" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="4" Text="数量" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Grid.Column="5" Text="小计" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- 商品明细列表 -->
                <ListView x:Name="ItemsListView" 
                          MaxHeight="220" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          SelectionMode="None" 
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                          BorderThickness="1,0,1,1" 
                          CornerRadius="0,0,6,6">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="36"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:AiPurchaseOrderItemDto">
                            <Grid Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Specification}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Barcode}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{x:Bind SaleUnit}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{x:Bind CostPrice}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{x:Bind Quantity}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind Subtotal}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
