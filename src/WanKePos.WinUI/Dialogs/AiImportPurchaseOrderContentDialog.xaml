<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.AiImportPurchaseOrderContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:WanKePos.Domain.Models"
    xmlns:converters="using:WanKePos.WinUI.Converters"
    mc:Ignorable="d"
    Title="AI 手写采购单智能识别与导入"
    PrimaryButtonText="导入到待制采购单"
    CloseButtonText="取消"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="False"
    MaxWidth="880"
    MaxHeight="780"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter"/>
        <!-- 覆盖 WinUI 3 默认 548px 限制，允许对话框舒展撑开 -->
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">780</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                  HorizontalScrollBarVisibility="Disabled" 
                  MaxHeight="700" 
                  Width="840">
        <StackPanel Spacing="10" Margin="0,4,12,6">

            <!-- 顶部操作辅助工具条 -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="请粘贴 AI 识别出的 JSON / YAML 文本，或选择文件：" 
                           FontSize="13" 
                           VerticalAlignment="Center" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Grid.Column="1" 
                        Click="CopyPromptButton_Click" 
                        ToolTipService.ToolTip="复制专用的手写单据 OCR 提示词，发给 ChatGPT/Claude/Gemini/DeepSeek">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8C8;" FontSize="12"/>
                        <TextBlock Text="复制 AI 提示词" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" 
                        Click="SelectFileButton_Click" 
                        ToolTipService.ToolTip="支持 .json, .yaml, .yml 或 .txt 文件">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                        <TextBlock Text="选择文件" FontSize="12"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" 
                        Click="ClearInputButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                        <TextBlock Text="清空" FontSize="12"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 提示词复制成功徽标 -->
            <InfoBar x:Name="PromptCopiedInfoBar" 
                     Severity="Success" 
                     Title="提示词已复制到剪贴板！" 
                     Message="您可直接在 ChatGPT/Claude/Gemini/DeepSeek 中粘贴提示词并附带手写单照片发送。" 
                     IsOpen="False"/>

            <!-- 原始输入区 (支持智能折叠展开) -->
            <Expander x:Name="InputExpander" 
                      IsExpanded="True" 
                      HorizontalAlignment="Stretch" 
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid HorizontalAlignment="Stretch">
                        <TextBlock x:Name="ExpanderHeaderTextBlock" 
                                   Text="📝 原始识别文本输入" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="8" Margin="0,4,0,4">
                        <TextBox x:Name="InputTextBox" 
                                 AcceptsReturn="True" 
                                 TextWrapping="Wrap" 
                                 Height="130" 
                                 PlaceholderText="在此直接粘贴 AI 返回的 JSON 或 YAML 文本（支持包含 ```json 代码块）..." 
                                 FontFamily="Consolas, Cascadia Code, Courier New" 
                                 FontSize="12"
                                 TextChanged="InputTextBox_TextChanged"/>

                        <!-- 解析操作栏 -->
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button x:Name="ParseButton" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Click="ParseButton_Click" 
                                    Height="34" 
                                    Padding="16,0"
                                    CornerRadius="6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE721;" FontSize="12"/>
                                    <TextBlock Text="智能解析并核对" FontSize="13" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="StatusMessageTextBlock" 
                                       VerticalAlignment="Center" 
                                       FontSize="13" 
                                       Foreground="{ThemeResource CriticalTextBrush}" 
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Expander.Content>
            </Expander>

            <!-- 识别结果预览区 (成功解析后展示) -->
            <StackPanel x:Name="PreviewPanel" Spacing="10" Visibility="Collapsed">
                
                <!-- 单据头部信息卡片 -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="14,10">
                    <Grid RowSpacing="8" ColumnSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.7*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 第一行：供货商、制单日期、备注 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="供货商:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SupplierTextBlock" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="制单日期:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OrderDateTextBlock" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="单据备注:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RemarkTextBlock" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 第二行：明细品类数、采购总件数、采购总金额 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="品类品种数:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ItemsCountTextBlock" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="采购总件数:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalQuantityTextBlock" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>

                            <TextBlock Text="采购总金额:" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TotalAmountTextBlock" FontWeight="Bold" FontSize="15" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 算术校验提示 -->
                <InfoBar x:Name="ArithmeticInfoBar" 
                         Severity="Informational" 
                         IsOpen="False" 
                         IsClosable="False"/>

                <!-- 明细表头与列表容器 -->
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 商品明细表头 -->
                        <Border Grid.Row="0" 
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                BorderThickness="0,0,0,1" 
                                CornerRadius="6,6,0,0" 
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="2.3*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="95"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="#" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="商品名称" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="规格 / 条码" FontWeight="Bold" FontSize="12"/>
                                <TextBlock Grid.Column="3" Text="单位" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="进价" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="数量" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="小计金额" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- 商品明细列表 -->
                        <ListView Grid.Row="1" 
                                  x:Name="ItemsListView" 
                                  MaxHeight="360" 
                                  ScrollViewer.VerticalScrollBarVisibility="Auto" 
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="38"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:AiPurchaseOrderItemDto">
                                    <Grid Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="2.3*"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="55"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="75"/>
                                            <ColumnDefinition Width="95"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- 序号 -->
                                        <TextBlock Grid.Column="0" 
                                                   Text="{x:Bind Index}" 
                                                   FontSize="11" 
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"/>

                                        <!-- 商品名称 -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{x:Bind Name}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   VerticalAlignment="Center" 
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Name}"/>

                                        <!-- 规格与条码 -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{x:Bind Specification}" 
                                                       FontSize="11" 
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Specification}"/>
                                            <TextBlock Text="{x:Bind Barcode}" 
                                                       FontSize="10" 
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{x:Bind Barcode}"/>
                                        </StackPanel>

                                        <!-- 单位 -->
                                        <TextBlock Grid.Column="3" 
                                                   Text="{x:Bind SaleUnit}" 
                                                   FontSize="12" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center"/>

                                        <!-- 进价 -->
                                        <TextBlock Grid.Column="4" 
                                                   Text="{x:Bind CostPrice, Converter={StaticResource DecimalToCurrencyConverter}}" 
                                                   FontSize="12" 
                                                   FontWeight="SemiBold" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"/>

                                        <!-- 数量 -->
                                        <TextBlock Grid.Column="5" 
                                                   Text="{x:Bind Quantity}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"/>

                                        <!-- 小计 -->
                                        <TextBlock Grid.Column="6" 
                                                   Text="{x:Bind Subtotal, Converter={StaticResource DecimalToCurrencyConverter}}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{ThemeResource PriceHighlightBrush}" 
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ContentDialog>
