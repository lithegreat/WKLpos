<ContentDialog
    x:Class="WanKePos.WinUI.Dialogs.OrderDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="销售流水详情与修改"
    PrimaryButtonText="保存修改"
    CloseButtonText="关闭"
    DefaultButton="Close"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">780</x:Double>
    </ContentDialog.Resources>

    <Grid Width="740" RowSpacing="12" Margin="0,4,0,0">
        <Grid.RowDefinitions>
            <!-- 订单头部与编辑项 -->
            <RowDefinition Height="Auto"/>
            <!-- 明细表头 -->
            <RowDefinition Height="Auto"/>
            <!-- 明细数据列表 -->
            <RowDefinition Height="*"/>
            <!-- 底部结算统计条 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第一行：订单概览与修改配置卡片 -->
        <Border Grid.Row="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Padding="16,12">
            <StackPanel Spacing="10">
                <!-- 单号与状态 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="订单号:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OrderNoTextBlock" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="CopyOrderNoButton" Click="CopyOrderNoButton_Click" Height="26" Width="26" Padding="0" CornerRadius="4" ToolTipService.ToolTip="复制订单号">
                            <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1" 
                            x:Name="PrintReceiptButton" 
                            Click="PrintReceiptButton_Click"
                            Height="28" 
                            Padding="8,0" 
                            Margin="0,0,8,0"
                            CornerRadius="4" 
                            ToolTipService.ToolTip="重新打印小票">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE749;" FontSize="11"/>
                            <TextBlock Text="打印小票" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="2" 
                            x:Name="StatusBadgeBorder" 
                            CornerRadius="4" 
                            Padding="8,3" 
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadgeTextBlock" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- 信息卡片与可修改字段 -->
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 下单时间 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="交易时间:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="CreatedAtTextBlock" FontSize="12"/>
                    </StackPanel>

                    <!-- 会员信息 -->
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="会员客户:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="MemberInfoTextBlock" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 支付方式修改 -->
                    <Grid Grid.Row="1" Grid.Column="0" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="支付方式:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="PaymentMethodComboBox" Height="30" HorizontalAlignment="Stretch" FontSize="12">
                            <ComboBoxItem Content="现金支付 (Cash)" Tag="0"/>
                            <ComboBoxItem Content="会员余额 (MemberBalance)" Tag="1"/>
                            <ComboBoxItem Content="组合支付 (Combined)" Tag="2"/>
                        </ComboBox>
                    </Grid>

                    <!-- 订单状态修改 -->
                    <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="订单状态:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="OrderStatusComboBox" Height="30" HorizontalAlignment="Stretch" FontSize="12">
                            <ComboBoxItem Content="正常 (Normal)" Tag="0"/>
                            <ComboBoxItem Content="已退款/作废 (Refunded)" Tag="1"/>
                        </ComboBox>
                    </Grid>

                    <!-- 备注修改 -->
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="备　　注:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" x:Name="RemarkTextBox" Height="30" FontSize="12" PlaceholderText="填写订单流水备注说明 (选填)"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 第二行：明细表头 -->
        <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1,1,1,0" 
                CornerRadius="6,6,0,0" 
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>    <!-- 序号 -->
                    <ColumnDefinition Width="*"/>     <!-- 商品名称 -->
                    <ColumnDefinition Width="130"/>   <!-- 条码 -->
                    <ColumnDefinition Width="70"/>    <!-- 零售原价 -->
                    <ColumnDefinition Width="70"/>    <!-- 实售单价 -->
                    <ColumnDefinition Width="65"/>    <!-- 购买数量 -->
                    <ColumnDefinition Width="80"/>    <!-- 小计金额 -->
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="#" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="商品名称" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="条码" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="零售价" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="4" Text="实售价" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="5" Text="数量" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="小计" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 第三行：明细数据列表 -->
        <Border Grid.Row="2"
                MaxHeight="260"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1,0,1,1" 
                CornerRadius="0,0,6,6"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ListView x:Name="ItemsListView" 
                      SelectionMode="None" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="32"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" 
                                BorderThickness="0,0,0,1" 
                                Padding="12,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Index}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProductName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Grid.Column="2" Background="{ThemeResource PillNeutralBackgroundBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Barcode}" FontSize="10" Foreground="{ThemeResource PillNeutralForegroundBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding ActualPrice, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding Quantity}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- 第四行：底部财务汇总条 -->
        <Border Grid.Row="3" 
                Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="原价总计: ¥" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="OriginalTotalTextBlock" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="优惠: ¥" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="DiscountTextBlock" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SuccessTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="实付: ¥" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PaidAmountTextBlock" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock Text="积分:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PointsTextBlock" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="应付合计:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PayableAmountTextBlock" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ContentDialog>
