<Page
    x:Class="WanKePos.WinUI.Views.OrderHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WanKePos.WinUI.Controls"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WinUI Gallery 标准标头 -->
        <controls:PageHeader Grid.Row="0"
                             Title="销售记录与流水" 
                             Description="查看店铺各日期营业汇总、实时流水明细与各笔订单详情" 
                             Glyph="&#xE8A5;"
                             BadgeText="快捷键 F4">
            <!-- 日期快捷切换与筛选工具栏 -->
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding PreviousDayCommand}" 
                        Height="34" Width="36" Padding="0" 
                        CornerRadius="4" 
                        ToolTipService.ToolTip="查看前一天流水">
                    <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                </Button>

                <CalendarDatePicker x:Name="HistoryCalendarDatePicker"
                                    Date="{Binding SelectedDate, Mode=TwoWay}" 
                                    DateChanged="CalendarDatePicker_DateChanged"
                                    DateFormat="{}{year.full}-{month.integer(2)}-{day.integer(2)}"
                                    Height="34" 
                                    Width="150"
                                    VerticalAlignment="Center"/>

                <Button Command="{Binding NextDayCommand}" 
                        Height="34" Width="36" Padding="0" 
                        CornerRadius="4" 
                        ToolTipService.ToolTip="查看后一天流水">
                    <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                </Button>

                <Button Command="{Binding GoToTodayCommand}" 
                        Content="今天" 
                        Height="34" 
                        Padding="12,0" 
                        CornerRadius="4" 
                        ToolTipService.ToolTip="返回今天流水"/>

                <Button Command="{Binding RefreshCommand}" 
                        Height="34" 
                        Padding="12,0"
                        CornerRadius="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                        <TextBlock Text="刷新" FontSize="12"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>
        
        <!-- 今日/选定日期统计 KPI 卡片 (WinUI Gallery 仪表盘风格) -->
        <Grid Grid.Row="1" Margin="0,0,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 销售总额卡片 -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="{ThemeResource OrderStatSalesBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding SalesCardTitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedDateTotalSales, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource OrderStatSalesBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 订单笔数卡片 -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A1;" FontSize="20" Foreground="{ThemeResource OrderStatCountBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding OrderCountCardTitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedDateOrderCount}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource OrderStatCountBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 预估毛利卡片 -->
            <Border Grid.Column="2" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,14">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE7BF;" FontSize="20" Foreground="{ThemeResource OrderStatProfitBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding ProfitCardTitle}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedDateProfit, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource OrderStatProfitBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 历史订单表格 (WinUI Gallery 表格风格) -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 表头 -->
            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="65"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="订单号" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="交易时间" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="会员姓名" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="会员手机" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="应付金额" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="实付金额" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="支付方式" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="积分变动" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="订单状态" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="操作" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行 -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding Orders}" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="None"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      CornerRadius="0,0,8,8"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,6" DoubleTapped="OrderRow_DoubleTapped">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OrderNo}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding MemberName}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding MemberPhone}" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding PayableAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="5" Text="{Binding PaidAmount, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Column="6" Text="{Binding PaymentMethod}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Column="7" Text="{Binding PointsEarned}" Foreground="{ThemeResource SuccessTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock Grid.Column="8" Text="{Binding Status}" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="9" 
                                    Click="ViewOrderDetailButton_Click" 
                                    Height="28" 
                                    Padding="8,0" 
                                    FontSize="11" 
                                    CornerRadius="4" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE70F;" FontSize="10"/>
                                    <TextBlock Text="详情/修改"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
