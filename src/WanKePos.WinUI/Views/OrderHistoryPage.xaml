<Page
    x:Class="WanKePos.WinUI.Views.OrderHistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 今日统计卡片 -->
        <Grid Grid.Row="0" Margin="0,0,0,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="#28A745" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="今日销售总额" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding TodayTotalSales, Converter={StaticResource CurrencyConverter}}" FontSize="24" FontWeight="Bold" Foreground="#28A745"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="#007ACC" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="今日订单总笔数" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding TodayOrderCount}" FontSize="24" FontWeight="Bold" Foreground="#007ACC"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="#FF8C00" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="16,12">
                <StackPanel Spacing="4">
                    <TextBlock Text="今日预估毛利" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding TodayProfit, Converter={StaticResource CurrencyConverter}}" FontSize="24" FontWeight="Bold" Foreground="#FF8C00"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="3" 
                    Content="🔄 刷新数据" 
                    Command="{Binding RefreshCommand}" 
                    Height="44" 
                    Padding="16,0" 
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- 历史订单表格 -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 表头 -->
            <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="85"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="订单号" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="交易时间" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="会员姓名" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="会员手机" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="应付金额" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="实付金额" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="支付方式" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="积分变动" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="订单状态" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行 -->
            <ListView Grid.Row="1" 
                      ItemsSource="{Binding Orders}" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="None"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      CornerRadius="0,0,8,8"
                      Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="40"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OrderNo}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding MemberName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding MemberPhone}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding PayableAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#FF8C00" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding PaidAmount, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding PaymentMethod}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{Binding PointsEarned}" Foreground="LightGreen" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{Binding Status}" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
