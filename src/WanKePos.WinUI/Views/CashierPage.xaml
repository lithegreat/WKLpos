<Page
    x:Class="WanKePos.WinUI.Views.CashierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="20,16,20,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="370"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：商品分类 (WinUI Gallery 侧栏导航风格) -->
        <Border Grid.Column="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" 
                Margin="0,0,12,0" 
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="6,4,4,12">
                    <FontIcon Glyph="&#xE8EC;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="商品品类" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                                        Click="CategoryButton_Click"
                                        Style="{StaticResource CategoryItemButtonStyle}"
                                        Margin="0,0,0,3"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 中栏：商品列表 & 扫码框 (WinUI Gallery 卡片列表) -->
        <Border Grid.Column="1" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" 
                Margin="0,0,12,0" 
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 扫码与搜索栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <TextBox x:Name="BarcodeTextBox" 
                             Text="{Binding BarcodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="输入条码/商品名后按回车，或使用扫码枪直接扫码" 
                             FontSize="14" 
                             Height="42" 
                             KeyDown="BarcodeTextBox_KeyDown"/>
                </Grid>

                <!-- 商品卡片列表 -->
                <ListView Grid.Row="1"
                          ItemsSource="{Binding DisplayProducts}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="None"
                          Padding="0">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="24" IsStaggeringEnabled="True"/>
                            <RepositionThemeTransition/>
                            <AddDeleteThemeTransition/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <!-- 条码胶囊 -->
                                            <Border Background="{ThemeResource PillNeutralBackgroundBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="{ThemeResource PillNeutralForegroundBrush}"/>
                                            </Border>
                                            <!-- 分类胶囊 -->
                                            <Border Background="{ThemeResource PillInfoBackgroundBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StoreCategory}" FontSize="11" Foreground="{ThemeResource PillInfoForegroundBrush}"/>
                                            </Border>
                                            <!-- 库存胶囊 -->
                                            <Border Background="{ThemeResource StockNormalBackgroundBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="库存:" FontSize="11" Foreground="{ThemeResource StockNormalForegroundBrush}"/>
                                                    <TextBlock Text="{Binding Stock}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource StockNormalForegroundBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 价格区域 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="{Binding RetailPrice, Converter={StaticResource CurrencyConverter}}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" HorizontalAlignment="Right"/>
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                            <TextBlock Text="会员价" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding MemberPrice, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SuccessTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 加购按钮 -->
                                    <Button Grid.Column="2" 
                                            Click="AddProductButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Height="34" 
                                            Padding="12,0" 
                                            CornerRadius="6"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="11"/>
                                            <TextBlock Text="加购" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 右栏：购物车 & 结算区 (WinUI Gallery 一体化面板) -->
        <Border Grid.Column="2" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" 
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 购物车标题 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                    <FontIcon Glyph="&#xE7BF;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="收银购物车" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 会员查找 (实时联想下拉) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,10" Spacing="6">
                    <AutoSuggestBox x:Name="MemberAutoSuggestBox" 
                                    Text="{Binding MemberPhoneInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    PlaceholderText="输入手机号/卡号/姓名 (下拉联想)" 
                                    Height="38"
                                    QueryIcon="Find"
                                    TextChanged="MemberAutoSuggestBox_TextChanged"
                                    SuggestionChosen="MemberAutoSuggestBox_SuggestionChosen"
                                    QuerySubmitted="MemberAutoSuggestBox_QuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4" MinWidth="260">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding Phone}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding MemberNo}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock Text="积分:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding TotalPoints}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="3">
                                            <TextBlock Text="余额:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Balance, Converter={StaticResource CurrencyConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SuccessTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6" 
                            Padding="10,6"
                            Visibility="{Binding MemberPanelVisibility}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontSize="13" Foreground="{ThemeResource SuccessTextBrush}"/>
                                <TextBlock Text="{Binding MemberDisplayText}" 
                                           VerticalAlignment="Center" 
                                           FontWeight="SemiBold" 
                                           FontSize="12" 
                                           Foreground="{ThemeResource SuccessTextBrush}"/>
                            </StackPanel>
                            <Button Content="清除" 
                                    Click="ClearMemberButton_Click" 
                                    HorizontalAlignment="Right" 
                                    Padding="8,2" 
                                    FontSize="11"/>
                        </Grid>
                    </Border>
                </StackPanel>
                
                <!-- 购物车明细 -->
                <ListView Grid.Row="2" 
                          ItemsSource="{Binding CartItems}" 
                          SelectionMode="None"
                          Margin="0,0,0,10">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ActualPrice, Converter={StaticResource CurrencyConverter}}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="3" Margin="6,0">
                                        <Button Content="-" Click="DecreaseQuantityButton_Click" Padding="0" Height="26" Width="26" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Quantity}" MinWidth="22" TextAlignment="Center" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                                        <Button Content="+" Click="IncreaseQuantityButton_Click" Padding="0" Height="26" Width="26" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" 
                                               FontWeight="Bold" 
                                               FontSize="14"
                                               Foreground="{ThemeResource PriceHighlightBrush}" 
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>

                                    <Button Grid.Column="3" 
                                            Click="RemoveCartItemButton_Click"
                                            Padding="4,2" 
                                            Height="28"
                                            Width="28"
                                            ToolTipService.ToolTip="从购物车移除">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="{ThemeResource CriticalTextBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <!-- 汇总与结算 -->
                <StackPanel Grid.Row="3" Spacing="10">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,10,0,0">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="商品小计:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, Converter={StaticResource CurrencyConverter}}" FontSize="13"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="会员优惠:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" FontSize="13" Foreground="{ThemeResource SuccessTextBrush}"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="应付合计:" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PayableAmount, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" 
                                Command="{Binding CheckoutCashCommand}" 
                                Style="{StaticResource AccentButtonStyle}"
                                Height="44" 
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C7;" FontSize="15"/>
                                <TextBlock Text="现金结算" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1" 
                                Command="{Binding CheckoutBalanceCommand}" 
                                IsEnabled="{Binding IsMemberMode}"
                                Height="44" 
                                HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8C8;" FontSize="15"/>
                                <TextBlock Text="余额支付" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" 
                                Command="{Binding ClearCartCommand}" 
                                Height="44" 
                                Width="52" 
                                ToolTipService.ToolTip="清空购物车">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
