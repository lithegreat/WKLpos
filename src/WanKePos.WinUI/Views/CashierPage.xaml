<Page
    x:Class="WanKePos.WinUI.Views.CashierPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：商品分类 -->
        <Border Grid.Column="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" 
                Margin="0,0,10,0" 
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="📦 商品分类" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,12"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                                        Click="CategoryButton_Click"
                                        HorizontalAlignment="Stretch" 
                                        Height="42" 
                                        FontSize="14" 
                                        Margin="0,0,0,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 中栏：商品列表 & 扫码框 -->
        <Border Grid.Column="1" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" 
                Margin="0,0,10,0" 
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" 
                         x:Name="BarcodeTextBox" 
                         Text="{Binding BarcodeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         PlaceholderText="🔍 扫码枪扫码 或 输入条码/商品名后按回车" 
                         FontSize="16" 
                         Height="48" 
                         Margin="0,0,0,12"
                         KeyDown="BarcodeTextBox_KeyDown"/>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding DisplayProducts}"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionMode="None"
                          Padding="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Spacing="12">
                                            <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding StoreCategory}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <TextBlock Text="{Binding Stock}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding RetailPrice}" FontSize="17" FontWeight="Bold" Foreground="#FF8C00" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding MemberPrice}" FontSize="12" Foreground="LightGreen" HorizontalAlignment="Right"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" 
                                            Content="+ 加入" 
                                            Click="AddProductButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Height="38" 
                                            Padding="14,0" 
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- 右栏：购物车 & 结算区 -->
        <Border Grid.Column="2" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" 
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 会员查找 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="6">
                    <TextBox Text="{Binding MemberPhoneInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PlaceholderText="📱 输入手机号查找会员 (按回车)" 
                             Height="40"
                             KeyDown="MemberPhoneTextBox_KeyDown"/>

                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                            CornerRadius="6" 
                            Padding="10,6"
                            Visibility="{Binding MemberPanelVisibility}">
                        <Grid>
                            <TextBlock Text="{Binding MemberDisplayText}" 
                                       VerticalAlignment="Center" 
                                       FontWeight="SemiBold" 
                                       FontSize="13" 
                                       Foreground="LightGreen"/>
                            <Button Content="清除" 
                                    Command="{Binding ClearMemberCommand}" 
                                    HorizontalAlignment="Right" 
                                    Padding="8,2" 
                                    FontSize="12"/>
                        </Grid>
                    </Border>
                </StackPanel>
                
                <!-- 购物车明细 -->
                <ListView Grid.Row="1" 
                          ItemsSource="{Binding CartItems}" 
                          SelectionMode="None"
                          Margin="0,0,0,10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,8"
                                    Margin="0,0,0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ActualPrice}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4" Margin="8,0">
                                        <Button Content="-" Click="DecreaseQuantityButton_Click" Padding="6,2" Height="30" MinWidth="30"/>
                                        <TextBlock Text="{Binding Quantity}" MinWidth="24" TextAlignment="Center" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                        <Button Content="+" Click="IncreaseQuantityButton_Click" Padding="6,2" Height="30" MinWidth="30"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding Subtotal}" 
                                               FontWeight="Bold" 
                                               FontSize="15"
                                               Foreground="#FF8C00" 
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>

                                    <Button Grid.Column="3" 
                                            Content="🗑️" 
                                            Click="RemoveCartItemButton_Click"
                                            Padding="4,2" 
                                            Height="30"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <!-- 汇总与结算 -->
                <StackPanel Grid.Row="2" Spacing="10">
                    <Border BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,10,0,0">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="商品小计:" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal}" FontSize="14"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="会员优惠:" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DiscountAmount}" FontSize="14" Foreground="LightGreen"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="应付合计:" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PayableAmount}" FontSize="24" FontWeight="Bold" Foreground="#FF8C00" Margin="0,6,0,0"/>
                        </Grid>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" 
                                Content="💵 现金结算" 
                                Command="{Binding CheckoutCashCommand}" 
                                Style="{StaticResource AccentButtonStyle}"
                                Background="#FF8C00"
                                Height="48" 
                                FontSize="16" 
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="1" 
                                Content="💳 余额支付" 
                                Command="{Binding CheckoutBalanceCommand}" 
                                IsEnabled="{Binding IsMemberMode}"
                                Height="48" 
                                FontSize="16" 
                                HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="2" 
                                Content="清空" 
                                Command="{Binding ClearCartCommand}" 
                                Height="48" 
                                Width="54" 
                                FontSize="14"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
