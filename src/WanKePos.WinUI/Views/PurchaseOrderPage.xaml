<Page
    x:Class="WanKePos.WinUI.Views.PurchaseOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:WanKePos.Domain.Entities"
    xmlns:enums="using:WanKePos.Domain.Enums"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    xmlns:controls="using:WanKePos.WinUI.Controls"
    Background="Transparent"
    mc:Ignorable="d">



    <Grid Padding="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent 规范页面大标头 -->
        <controls:PageHeader Grid.Row="0"
                             Title="采购进货管理" 
                             Description="制作采购单据、到货一键入库及 AI 单据拍照识别" 
                             Glyph="&#xE8F1;"
                             BadgeText="快捷键 F5">
            <Button Command="{Binding ImportFromAiCommand}" 
                    Height="36" 
                    Padding="14,0" 
                    ToolTipService.ToolTip="拍照手写采购单，上传 AI 识别后在此直接粘贴或导入文件">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE99A;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="AI 拍照识单导入" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </controls:PageHeader>

        <!-- 顶部功能切换原生 WinUI 选项卡按钮组 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button x:Name="TabOrdersButton" 
                    Click="TabOrdersButton_Click"
                    Height="36" 
                    Padding="16,0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                    <TextBlock Text="采购单记录与入库" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="TabCreateOrderButton" 
                    Click="TabCreateOrderButton_Click"
                    Height="36" 
                    Padding="16,0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="制作采购单 (快速制作与待制单)" FontWeight="SemiBold"/>
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" 
                            CornerRadius="10" 
                            Padding="7,1" 
                            VerticalAlignment="Center"
                            Visibility="{x:Bind GetCartBadgeVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.CartItems.Count, Mode=OneWay}" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                    </Border>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- TAB 0: 采购单列表与一键入库 -->
        <Grid Grid.Row="2" Visibility="{x:Bind GetTab0Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作提示条 -->
            <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="说明：货到后点击【一键入库】即可自动增加商品库存；支持点击右上角【AI 拍照识单导入】智能识别进货单据。" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" 
                            Command="{Binding LoadOrdersCommand}" 
                            Height="32" 
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="刷新列表" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 表头 -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="采购单号" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="供货商" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="制单时间" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="品类数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="采购总数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="采购总额" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="单据状态" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="操作" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行与空状态提示 -->
            <Grid Grid.Row="2">
                <ListView ItemsSource="{Binding PurchaseOrders}" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1,0,1,1"
                          CornerRadius="0,0,8,8"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding PurchaseOrderNo}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, Converter={StaticResource DateTimeFormatConverter}}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalItemsCount}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding TotalQuantity}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                                
                                <!-- 状态彩色标签 -->
                                <Border Grid.Column="6" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        CornerRadius="4" 
                                        Padding="8,3"
                                        Background="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=Background}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}}" 
                                               FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=Foreground}"/>
                                </Border>

                                <!-- 操作按钮组 (根据状态智能显隐) -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- 一键入库：仅 Draft 状态可见 -->
                                    <Button Click="StockInButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Height="30" 
                                            Padding="10,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=DraftOnly}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                                            <TextBlock Text="一键入库" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 导出Excel：Draft 和 Received 状态可见 -->
                                    <Button Click="ExportExcelButton_Click"
                                            Height="30" 
                                            Padding="10,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=NotCancelled}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEDE1;" FontSize="12"/>
                                            <TextBlock Text="导出Excel" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 删除：仅 Draft 和 Cancelled 状态可见 -->
                                    <Button Click="DeleteOrderButton_Click"
                                            Height="30" 
                                            Padding="8,0"
                                            ToolTipService.ToolTip="删除单据"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=NotReceived}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态友好提示面板 -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="12"
                            Visibility="{x:Bind GetEmptyOrdersVisibility(ViewModel.PurchaseOrders.Count), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无采购单记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="点击顶部【快速制作采购单】或【AI 拍照识单导入】创建您的第一张采购单" 
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- TAB 1: 快速制作采购单与待制采购单 (同屏同时显示，支持手动拖动调节两边大小) -->
        <Grid x:Name="WorkbenchGrid" Grid.Row="2" Visibility="{x:Bind GetTab1Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <!-- 左栏：商品分类 -->
                <ColumnDefinition Width="150"/>
                <!-- 中栏：快速选品区 (弹性填充) -->
                <ColumnDefinition x:Name="ProductColumn" Width="*" MinWidth="320"/>
                <!-- 中间选品区与右侧待制采购单大小调节分隔条 (可左右拖动) -->
                <ColumnDefinition Width="Auto"/>
                <!-- 右栏：待制采购单 (支持左右拖动调整宽度) -->
                <ColumnDefinition x:Name="CartColumn" Width="380" MinWidth="300" MaxWidth="750"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：商品品类 (固定舒适宽度 150px，不折叠) -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,10,0" 
                    Padding="8,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="4,2,4,10">
                        <FontIcon Glyph="&#xE8EC;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="商品品类" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Style="{Binding Converter={StaticResource CategoryToStyleConverter}}"
                                            Click="CategoryButton_Click" 
                                            Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 中栏：快速制作采购单 (商品选品卡片，自适应充满，商品名与采购按钮绝不折叠) -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,0,0" 
                    Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部工具栏：搜索、筛选、件数统计 -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧搜索与当前分类 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <AutoSuggestBox x:Name="ProductSearchBox"
                                            QueryIcon="Find"
                                            PlaceholderText="搜索商品名称或条码"
                                            Width="180"
                                            Height="32"
                                            Text="{Binding SearchProductKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            QuerySubmitted="ProductSearchBox_QuerySubmitted"/>
                            <Button Content="重置" Command="{Binding ResetProductSearchCommand}" Height="32" Padding="10,0" CornerRadius="4"/>

                            <!-- 当前分类指示胶囊 -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="8,2" 
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="分类:" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCategory}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 右侧商品统计与提示 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="10" 
                                    Padding="8,2" 
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="共" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding AvailableProductCount}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="件" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="双击行可加购" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 商品列表 (卡片行布局：商品名全展开换行不折叠，价格库存清晰，采购按钮大号独立) -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding AvailableProducts}" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="10,8" 
                                        Margin="0,0,0,5"
                                        DoubleTapped="ProductRow_DoubleTapped">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />     <!-- 商品名称与分类条码 -->
                                            <ColumnDefinition Width="Auto" />  <!-- 进货价与库存 -->
                                            <ColumnDefinition Width="Auto" />  <!-- 采购按钮 -->
                                        </Grid.ColumnDefinitions>

                                        <!-- 左侧：商品名称 (全宽展开，TextWrapping="Wrap"，绝不折叠截断) -->
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="13" 
                                                       TextWrapping="Wrap"
                                                       ToolTipService.ToolTip="{Binding Name}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <!-- 条码 -->
                                                <Border Background="{ThemeResource PillNeutralBackgroundBrush}" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="{Binding Barcode}" FontSize="10" Foreground="{ThemeResource PillNeutralForegroundBrush}"/>
                                                </Border>
                                                <!-- 分类 -->
                                                <Border Background="{ThemeResource PillInfoBackgroundBrush}" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="{Binding StoreCategory}" FontSize="10" Foreground="{ThemeResource PillInfoForegroundBrush}"/>
                                                </Border>
                                                <!-- 供应商 (如有) -->
                                                <TextBlock Text="{Binding Supplier}" 
                                                           FontSize="10" 
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                           VerticalAlignment="Center" 
                                                           TextTrimming="CharacterEllipsis" 
                                                           MaxWidth="110"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 中间：进货价与当前库存 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0" HorizontalAlignment="Right" Spacing="2">
                                            <TextBlock Text="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14" 
                                                       Foreground="{ThemeResource PriceHighlightBrush}" 
                                                       HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                                <TextBlock Text="库存:" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding Stock}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SaleUnit}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 右侧：采购按钮 (独立宽幅，清晰可见，绝不折叠) -->
                                        <Button Grid.Column="2" 
                                                Click="AddProductToDraftButton_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Height="30" 
                                                MinWidth="70"
                                                Padding="8,0" 
                                                CornerRadius="4"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE710;" FontSize="10"/>
                                                <TextBlock Text="采购" FontSize="12" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 中间选品区与右侧待制采购单大小调节分隔条 (可左右拖动，双击恢复默认宽度) -->
            <Border Grid.Column="2"
                    x:Name="CartSplitter"
                    Width="14"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Stretch"
                    PointerEntered="CartSplitter_PointerEntered"
                    PointerExited="CartSplitter_PointerExited"
                    PointerPressed="CartSplitter_PointerPressed"
                    PointerMoved="CartSplitter_PointerMoved"
                    PointerReleased="CartSplitter_PointerReleased"
                    PointerCaptureLost="CartSplitter_PointerCaptureLost"
                    DoubleTapped="CartSplitter_DoubleTapped"
                    ToolTipService.ToolTip="按住左右拖动调整选品区与待制单宽度 (双击恢复默认)">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <!-- 竖直视觉拖动手柄 -->
                    <Border x:Name="SplitterHandle"
                            Width="4" 
                            Height="56"
                            CornerRadius="2" 
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 右栏：待制采购单 (与选品区同屏同时显示，支持拖动调整宽度) -->
            <Border Grid.Column="3" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部标题与表头录入 -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="待制采购单" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" 
                                        CornerRadius="10" 
                                        Padding="6,1" 
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind GetCartBadgeVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.CartItems.Count, Mode=OneWay}" 
                                               FontSize="10" 
                                               FontWeight="Bold" 
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Command="{Binding ClearDraftCommand}" 
                                        Height="26" 
                                        Padding="8,0" 
                                        FontSize="11"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="清空待制单全部商品">
                                    <TextBlock Text="清空"/>
                                </Button>
                                <Button Command="{Binding ImportFromAiCommand}" 
                                        Height="26" 
                                        Padding="8,0" 
                                        FontSize="11"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="拍照或手写单据，AI 识别自动填入">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE99A;" FontSize="10" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="AI 识单"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 供货商名称输入 -->
                        <Grid ColumnSpacing="8" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="供货商:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="SupplierTextBox"
                                     Grid.Column="1" 
                                     PlaceholderText="例如：广州博美美发用品有限公司" 
                                     Text="{Binding SupplierInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     KeyDown="SupplierTextBox_KeyDown"/>
                        </Grid>

                        <!-- 采购备注输入 -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="备　注:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="RemarkTextBox"
                                     Grid.Column="1" 
                                     PlaceholderText="例如：加急发货 / 纸箱包装 (可选)" 
                                     Text="{Binding RemarkInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12"
                                     KeyDown="RemarkTextBox_KeyDown"/>
                        </Grid>
                    </StackPanel>

                    <!-- 中部已选采购明细 -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <!-- 有商品时展示明细列表 -->
                        <ListView ItemsSource="{Binding CartItems}" 
                                  SelectionMode="None"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  Padding="0"
                                  Visibility="{x:Bind GetHasCartItemsVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="6" 
                                            Padding="10,8" 
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- 第一行：商品名称 (全宽展开) + 小计 + 移除按钮 -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding ProductName}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13" 
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,8,0"
                                                           ToolTipService.ToolTip="{Binding ProductName}"/>

                                                <TextBlock Grid.Column="1" 
                                                           Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" 
                                                           FontWeight="Bold" 
                                                           FontSize="13" 
                                                           Foreground="{ThemeResource PriceHighlightBrush}" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,6,0"/>

                                                <Button Grid.Column="2" 
                                                        Click="RemoveDraftItemButton_Click" 
                                                        Height="26" Width="26" Padding="0" 
                                                        CornerRadius="4"
                                                        ToolTipService.ToolTip="移除该项">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                                                </Button>
                                            </Grid>

                                            <!-- 第二行：条码 + 进价输入框 + 数量加减 -->
                                            <Grid Grid.Row="1" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 条码 -->
                                                <TextBlock Grid.Column="0" 
                                                           Text="{Binding Barcode}" 
                                                           FontSize="10" 
                                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                                           VerticalAlignment="Center"/>

                                                <!-- 进价输入 -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="进价:" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBox Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="60" Height="26" Padding="3,0" FontSize="11" CornerRadius="4"
                                                             TextChanged="DraftCostPriceTextBox_TextChanged"
                                                             LostFocus="DraftCostPriceTextBox_LostFocus"
                                                             KeyDown="DraftNumericTextBox_KeyDown"/>
                                                </StackPanel>

                                                <!-- 数量步进器 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                    <Button Content="-" Click="DecreaseDraftQuantityButton_Click" Height="26" Width="24" Padding="0" CornerRadius="3"/>
                                                    <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                             Width="40" Height="26" TextAlignment="Center" Padding="1,0" FontSize="11" CornerRadius="3"
                                                             TextChanged="DraftQuantityTextBox_TextChanged"
                                                             LostFocus="DraftQuantityTextBox_LostFocus"
                                                             KeyDown="DraftNumericTextBox_KeyDown"/>
                                                    <Button Content="+" Click="IncreaseDraftQuantityButton_Click" Height="26" Width="24" Padding="0" CornerRadius="3"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 空状态提示 -->
                        <StackPanel VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" 
                                    Spacing="8" 
                                    Visibility="{x:Bind GetEmptyCartVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                            <FontIcon Glyph="&#xE8F1;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="待制单暂无商品" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="请在左侧挑选商品并点击【采购】" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 底部汇总与生成采购单 -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="品类:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CartItems.Count}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text=" | 总数:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="2,0,0,0"/>
                                    <TextBlock Text="{Binding DraftTotalQuantity}" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Text="件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="总额:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding DraftTotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Button Grid.Row="1" 
                                    Click="CreatePurchaseOrderButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Height="36" 
                                    HorizontalAlignment="Stretch"
                                    CornerRadius="6"
                                    FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74E;" FontSize="13"/>
                                    <TextBlock Text="生成采购单" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
