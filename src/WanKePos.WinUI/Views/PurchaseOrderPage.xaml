<Page
    x:Class="WanKePos.WinUI.Views.PurchaseOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:WanKePos.Domain.Entities"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部功能切换栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
            <RadioButtons SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" MaxColumns="2">
                <RadioButton Content="📋 采购单记录与入库" FontSize="15" FontWeight="SemiBold"/>
                <RadioButton Content="➕ 快速制作采购单" FontSize="15" FontWeight="SemiBold"/>
            </RadioButtons>
        </StackPanel>

        <!-- TAB 1: 采购单列表与一键入库 -->
        <Grid Grid.Row="1" Visibility="{x:Bind GetTab1Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作提示条 -->
            <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <TextBlock Text="💡 说明：货到后点击【一键入库】即可自动增加商品库存；点击【导出Excel】可生成专业订货单发给供货商。" 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                    <Button Content="🔄 刷新列表" 
                            Command="{Binding LoadOrdersCommand}" 
                            HorizontalAlignment="Right" 
                            Height="34" 
                            Padding="12,0"/>
                </Grid>
            </Border>

            <!-- 表头 -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="采购单号" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="供货商" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="制单时间" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="品类数" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="采购总数" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="采购总额" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="单据状态" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="操作" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行 -->
            <ListView Grid.Row="2" 
                      ItemsSource="{Binding PurchaseOrders}" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="None"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      CornerRadius="0,0,8,8"
                      Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="{Binding PurchaseOrderNo}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="2" Text="{Binding CreatedAt}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="3" Text="{Binding TotalItemsCount}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding TotalQuantity}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="{Binding TotalAmount}" FontWeight="Bold" Foreground="#FF8C00" VerticalAlignment="Center"/>
                            
                            <!-- 状态标签 -->
                            <TextBlock Grid.Column="6" Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                            <!-- 操作按钮组 -->
                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="📦 一键入库" 
                                        Click="StockInButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="32" 
                                        Padding="10,0"/>

                                <Button Content="📑 导出Excel" 
                                        Click="ExportExcelButton_Click"
                                        Height="32" 
                                        Padding="10,0"/>

                                <Button Content="🗑️" 
                                        Click="DeleteOrderButton_Click"
                                        Height="32" 
                                        Padding="8,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- TAB 2: 新建采购单 -->
        <Grid Grid.Row="1" Visibility="{x:Bind GetTab2Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左边：可选商品库 -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="12" 
                    Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📦 选择采购商品" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    
                    <TextBox Grid.Row="1" 
                             PlaceholderText="🔍 搜索商品名称或条码 (回车)" 
                             Text="{Binding SearchProductKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Height="40" 
                             Margin="0,0,0,10"
                             KeyDown="SearchProductTextBox_KeyDown"/>

                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding AvailableProducts}" 
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="10,8" 
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                <TextBlock Text="{Binding CostPrice}" FontSize="12" Foreground="#FF8C00"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Stock}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0"/>

                                        <Button Grid.Column="2" 
                                                Content="+ 加入" 
                                                Click="AddProductToDraftButton_Click"
                                                Height="32" 
                                                Padding="10,0" 
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右边：采购清单与提交 -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部采购单表头信息录入 -->
                    <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                     Header="供货商名称:" 
                                     PlaceholderText="例如：广州博美美发用品有限公司" 
                                     Text="{Binding SupplierInput, Mode=TwoWay}"/>
                            <TextBox Grid.Column="1" 
                                     Header="采购备注:" 
                                     PlaceholderText="例如：加急发货 / 纸箱包装" 
                                     Text="{Binding RemarkInput, Mode=TwoWay}"/>
                        </Grid>
                    </StackPanel>

                    <!-- 中部已选采购明细 -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding CartItems}" 
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="12,8" 
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Barcode}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                        </StackPanel>

                                        <!-- 采购单价 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="进价 (元):" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBox Text="{Binding CostPrice, Mode=TwoWay}" Height="32" Width="90" HorizontalAlignment="Left"/>
                                        </StackPanel>

                                        <!-- 数量操作 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                                            <Button Content="-" Click="DecreaseDraftQuantityButton_Click" Height="30" MinWidth="30"/>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay}" Width="48" Height="30" TextAlignment="Center"/>
                                            <Button Content="+" Click="IncreaseDraftQuantityButton_Click" Height="30" MinWidth="30"/>
                                        </StackPanel>

                                        <!-- 小计 -->
                                        <TextBlock Grid.Column="3" Text="{Binding Subtotal}" FontWeight="Bold" FontSize="15" Foreground="#FF8C00" VerticalAlignment="Center"/>

                                        <Button Grid.Column="4" Content="🗑️" Click="RemoveDraftItemButton_Click" Height="30" Padding="6,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 底部汇总与创建按钮 -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,12,0,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="采购总件数:" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DraftTotalQuantity}" FontSize="18" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="采购总金额:" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding DraftTotalAmount}" FontSize="22" FontWeight="Bold" Foreground="#FF8C00"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                <Button Content="清空重填" Command="{Binding ClearDraftCommand}" Height="44" Padding="16,0"/>
                                <Button Content="💾 生成采购单" 
                                        Command="{Binding CreatePurchaseOrderCommand}" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        Height="44" 
                                        Padding="24,0" 
                                        FontSize="15" 
                                        FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
