<Page
    x:Class="WanKePos.WinUI.Views.PurchaseOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:WanKePos.Domain.Entities"
    xmlns:enums="using:WanKePos.Domain.Enums"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    xmlns:controls="using:WanKePos.WinUI.Controls"
    Background="Transparent"
    mc:Ignorable="d">



    <Grid Padding="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Fluent 规范页面大标头 -->
        <controls:PageHeader Grid.Row="0"
                             Title="采购进货管理" 
                             Description="制作采购单据、到货一键入库及 AI 单据拍照识别" 
                             Glyph="&#xE8F1;"
                             BadgeText="快捷键 F5">
            <Button Command="{Binding ImportFromAiCommand}" 
                    Height="36" 
                    Padding="14,0" 
                    ToolTipService.ToolTip="拍照手写采购单，上传 AI 识别后在此直接粘贴或导入文件">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE99A;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="AI 拍照识单导入" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </controls:PageHeader>

        <!-- 顶部功能切换原生 WinUI 选项卡按钮组 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button x:Name="TabOrdersButton" 
                    Click="TabOrdersButton_Click"
                    Height="36" 
                    Padding="16,0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                    <TextBlock Text="采购单记录与入库" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="TabCreateOrderButton" 
                    Click="TabCreateOrderButton_Click"
                    Height="36" 
                    Padding="16,0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>
                    <TextBlock Text="快速制作采购单" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <Button x:Name="TabDraftOrderButton" 
                    Click="TabDraftOrderButton_Click"
                    Height="36" 
                    Padding="16,0"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                    <TextBlock Text="待制采购单" FontWeight="SemiBold"/>
                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" 
                            CornerRadius="10" 
                            Padding="7,1" 
                            VerticalAlignment="Center"
                            Visibility="{x:Bind GetCartBadgeVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.CartItems.Count, Mode=OneWay}" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                    </Border>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- TAB 0: 采购单列表与一键入库 -->
        <Grid Grid.Row="2" Visibility="{x:Bind GetTab0Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作提示条 -->
            <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock Text="说明：货到后点击【一键入库】即可自动增加商品库存；支持点击右上角【AI 拍照识单导入】智能识别进货单据。" 
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" 
                            Command="{Binding LoadOrdersCommand}" 
                            Height="32" 
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            <TextBlock Text="刷新列表" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 表头 -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="采购单号" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="供货商" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="制单时间" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="品类数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="采购总数" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="采购总额" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="单据状态" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="操作" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行与空状态提示 -->
            <Grid Grid.Row="2">
                <ListView ItemsSource="{Binding PurchaseOrders}" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1,0,1,1"
                          CornerRadius="0,0,8,8"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding PurchaseOrderNo}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, Converter={StaticResource DateTimeFormatConverter}}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalItemsCount}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding TotalQuantity}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                                
                                <!-- 状态彩色标签 -->
                                <Border Grid.Column="6" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        CornerRadius="4" 
                                        Padding="8,3"
                                        Background="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=Background}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}}" 
                                               FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=Foreground}"/>
                                </Border>

                                <!-- 操作按钮组 (根据状态智能显隐) -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- 一键入库：仅 Draft 状态可见 -->
                                    <Button Click="StockInButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Height="30" 
                                            Padding="10,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=DraftOnly}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
                                            <TextBlock Text="一键入库" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 导出Excel：Draft 和 Received 状态可见 -->
                                    <Button Click="ExportExcelButton_Click"
                                            Height="30" 
                                            Padding="10,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=NotCancelled}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xEDE1;" FontSize="12"/>
                                            <TextBlock Text="导出Excel" FontSize="12"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 删除：仅 Draft 和 Cancelled 状态可见 -->
                                    <Button Click="DeleteOrderButton_Click"
                                            Height="30" 
                                            Padding="8,0"
                                            ToolTipService.ToolTip="删除单据"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=NotReceived}">
                                        <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态友好提示面板 -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="12"
                            Visibility="{x:Bind GetEmptyOrdersVisibility(ViewModel.PurchaseOrders.Count), Mode=OneWay}">
                    <FontIcon Glyph="&#xE8A5;" FontSize="44" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无采购单记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="点击顶部【快速制作采购单】或【AI 拍照识单导入】创建您的第一张采购单" 
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- TAB 1: 快速制作采购单 (商品选品大宽幅页面，商品名与采购按钮绝不折叠) -->
        <Grid Grid.Row="2" Visibility="{x:Bind GetTab1Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：商品品类卡片 (固定舒适宽度 180px，不折叠) -->
            <Border Grid.Column="0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,12,0" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="4,2,4,12">
                        <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="商品品类" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Style="{Binding Converter={StaticResource CategoryToStyleConverter}}"
                                            Click="CategoryButton_Click" 
                                            Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右栏：商品选品大宽幅列表 (自适应充满，商品名与采购按钮绝不折叠) -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部工具栏：搜索、筛选、件数统计与右上角待制单快捷入口 -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧搜索与当前分类 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <AutoSuggestBox x:Name="ProductSearchBox"
                                            QueryIcon="Find"
                                            PlaceholderText="搜索商品名称或条码 (回车)"
                                            Width="240"
                                            Height="34"
                                            Text="{Binding SearchProductKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            QuerySubmitted="ProductSearchBox_QuerySubmitted"/>
                            <Button Content="重置" Command="{Binding ResetProductSearchCommand}" Height="34" Padding="12,0" CornerRadius="6"/>

                            <!-- 当前分类指示胶囊 -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="10,4" 
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="分类:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedCategory}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="12" 
                                    Padding="10,4" 
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="共" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding AvailableProductCount}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="件商品" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="（双击行亦可直接采购）" 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 右侧常驻待制单快捷入口 -->
                        <Button Grid.Column="1" 
                                Click="GoToDraftButton_Click" 
                                Style="{StaticResource AccentButtonStyle}"
                                Height="34" 
                                Padding="14,0" 
                                CornerRadius="6"
                                ToolTipService.ToolTip="点击前往【待制采购单】工作台，复核修改明细并生成采购单">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13"/>
                                <TextBlock Text="查看待制采购单" FontWeight="SemiBold" FontSize="12"/>
                                <Border Background="White" CornerRadius="10" Padding="6,1" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock Text="{x:Bind ViewModel.CartItems.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>
                                </Border>
                                <TextBlock Text="{x:Bind ViewModel.DraftTotalAmount, Converter={StaticResource CurrencyConverter}, Mode=OneWay}" FontSize="12" FontWeight="Bold" Margin="4,0,0,0"/>
                                <FontIcon Glyph="&#xE76C;" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 表头 (宽幅列排布，商品名称和采购按钮均有充足空间) -->
                    <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="95"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="条码" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="商品名称" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="分类" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="进货价" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="当前库存" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="单位" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="主要供应商" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="操作" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 数据行列表 (虚拟化渲染) -->
                    <ListView Grid.Row="2" 
                              ItemsSource="{Binding AvailableProducts}" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1,0,1,1"
                              CornerRadius="0,0,6,6"
                              Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="42"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,8" DoubleTapped="ProductRow_DoubleTapped" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Barcode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <!-- 商品名称：宽幅充分展开，完整呈现不折叠 -->
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StoreCategory}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Stock}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="{Binding SaleUnit}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <!-- 采购按钮：宽幅居中，舒适易点，绝不折叠 -->
                                    <Button Grid.Column="7" 
                                            Click="AddProductToDraftButton_Click"
                                            Height="30" 
                                            MinWidth="80"
                                            Padding="10,0" 
                                            CornerRadius="6"
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon Glyph="&#xE710;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="采购" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- TAB 2: 待制采购单 (独立全宽工作台与生成单据) -->
        <Grid Grid.Row="2" Visibility="{x:Bind GetTab2Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <!-- 内容区：有商品时展示明细工作台；无商品时展示友好引导 -->
            <Grid Visibility="{x:Bind GetHasCartItemsVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部单据信息卡片：供货商、采购备注与快捷操作 -->
                <Border Grid.Row="0" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="16,14" 
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" 
                                 Header="供货商名称:" 
                                 PlaceholderText="例如：广州博美美发用品有限公司" 
                                 Text="{Binding SupplierInput, Mode=TwoWay}"
                                 Margin="0,0,16,0"/>

                        <TextBox Grid.Column="1" 
                                 Header="采购单备注:" 
                                 PlaceholderText="例如：送货至总店仓库 / 加急发货" 
                                 Text="{Binding RemarkInput, Mode=TwoWay}"
                                 Margin="0,0,20,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                            <Button Click="ContinuePickingButton_Click" 
                                    Height="36" 
                                    Padding="14,0" 
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="返回商品列表继续加购更多进货商品">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="继续挑选商品" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportFromAiCommand}" 
                                    Height="36" 
                                    Padding="14,0" 
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="拍照或粘贴手写单据，AI 自动匹配并追加进货商品">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE99A;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="AI 拍照识单导入" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 表头：全宽排布，商品名称自适应占满，绝不折叠 -->
                <Border Grid.Row="1" 
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1,1,1,0" 
                        CornerRadius="6,6,0,0" 
                        Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="#" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="条码" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="商品名称" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="进货单价 (元)" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="采购数量" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="单位" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="采购小计" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="7" Text="操作" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 明细数据行列表 (支持单价即时修改与步进器加减) -->
                <ListView Grid.Row="2" 
                          ItemsSource="{Binding CartItems}" 
                          SelectionMode="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1,0,1,1"
                          CornerRadius="0,0,6,6"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="48"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="16,8" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>

                                <!-- 序号 -->
                                <TextBlock Grid.Column="0" Text="●" FontSize="8" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                
                                <!-- 条码 -->
                                <TextBlock Grid.Column="1" Text="{Binding Barcode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                
                                <!-- 商品名称：全宽充分展示，绝不折叠 -->
                                <TextBlock Grid.Column="2" 
                                           Text="{Binding ProductName}" 
                                           FontWeight="SemiBold" 
                                           FontSize="13" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding ProductName}"/>

                                <!-- 采购单价 (支持点击编辑) -->
                                <TextBox Grid.Column="3" 
                                         Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         Height="30" 
                                         Width="90" 
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         CornerRadius="4"
                                         TextChanged="DraftCostPriceTextBox_TextChanged"
                                         LostFocus="DraftCostPriceTextBox_LostFocus"
                                         KeyDown="DraftNumericTextBox_KeyDown"/>

                                <!-- 数量增减步进器 -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Spacing="3" HorizontalAlignment="Center">
                                    <Button Content="-" Click="DecreaseDraftQuantityButton_Click" Height="30" Width="30" Padding="0" CornerRadius="4"/>
                                    <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="58" Height="30" TextAlignment="Center" Padding="2,0" CornerRadius="4"
                                             TextChanged="DraftQuantityTextBox_TextChanged"
                                             LostFocus="DraftQuantityTextBox_LostFocus"
                                             KeyDown="DraftNumericTextBox_KeyDown"/>
                                    <Button Content="+" Click="IncreaseDraftQuantityButton_Click" Height="30" Width="30" Padding="0" CornerRadius="4"/>
                                </StackPanel>

                                <!-- 单位 -->
                                <TextBlock Grid.Column="5" Text="{Binding SaleUnit}" VerticalAlignment="Center"/>

                                <!-- 小计 -->
                                <TextBlock Grid.Column="6" 
                                           Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           Foreground="{ThemeResource PriceHighlightBrush}" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Right"/>

                                <!-- 移除按钮 -->
                                <Button Grid.Column="7" 
                                        Click="RemoveDraftItemButton_Click" 
                                        Height="30" 
                                        Padding="10,0" 
                                        HorizontalAlignment="Center"
                                        CornerRadius="4"
                                        ToolTipService.ToolTip="从待制采购单中移除">
                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 底部统计与生成采购单卡片 -->
                <Border Grid.Row="3" 
                        Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="18,14" 
                        Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧明细汇总统计 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="品类数:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CartItems.Count}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="种" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="采购总件数:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DraftTotalQuantity}" FontSize="17" FontWeight="Bold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="件" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Width="1" Height="16" Background="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="采购总金额:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding DraftTotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- 右侧操作主按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Button Content="清空待制单" 
                                    Command="{Binding ClearDraftCommand}" 
                                    Height="40" 
                                    Padding="18,0" 
                                    CornerRadius="6"/>
                            <Button Click="CreatePurchaseOrderButton_Click" 
                                    Style="{StaticResource AccentButtonStyle}" 
                                    Height="40" 
                                    Padding="24,0" 
                                    CornerRadius="6"
                                    FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14"/>
                                    <TextBlock Text="生成采购单" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 空状态提示 (待制采购单为空时展示) -->
            <Border Visibility="{x:Bind GetEmptyCartVisibility(ViewModel.CartItems.Count), Mode=OneWay}"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="32">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <FontIcon Glyph="&#xE8F1;" FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="待制采购单暂无商品" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="您可以前往【快速制作采购单】挑选需要采购的商品，或者使用【AI 拍照识单导入】一键载入手写单据" 
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button Click="ContinuePickingButton_Click" 
                                Style="{StaticResource AccentButtonStyle}" 
                                Height="38" 
                                Padding="20,0" 
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13"/>
                                <TextBlock Text="前往挑选商品" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ImportFromAiCommand}" 
                                Height="38" 
                                Padding="18,0" 
                                CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE99A;" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="AI 拍照识单导入" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
