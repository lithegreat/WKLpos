<Page
    x:Class="WanKePos.WinUI.Views.PurchaseOrderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:entities="using:WanKePos.Domain.Entities"
    xmlns:enums="using:WanKePos.Domain.Enums"
    xmlns:vm="using:WanKePos.WinUI.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部功能切换与快捷工具栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <RadioButtons Grid.Column="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" MaxColumns="2">
                <RadioButton Content="📋 采购单记录与入库" FontSize="15" FontWeight="SemiBold"/>
                <RadioButton Content="➕ 快速制作采购单" FontSize="15" FontWeight="SemiBold"/>
            </RadioButtons>

            <!-- 顶部全局 AI 导入快捷按钮 -->
            <Button Grid.Column="1" 
                    Content="🤖 AI 手写单拍照导入" 
                    Command="{Binding ImportFromAiCommand}" 
                    Style="{StaticResource AccentButtonStyle}" 
                    Height="36" 
                    Padding="14,0" 
                    FontSize="14" 
                    FontWeight="SemiBold"
                    ToolTipService.ToolTip="拍照手写采购单，上传 AI 识别后在此直接粘贴或导入文件"/>
        </Grid>

        <!-- TAB 1: 采购单列表与一键入库 -->
        <Grid Grid.Row="1" Visibility="{x:Bind GetTab1Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 操作提示条 -->
            <Border Grid.Row="0" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="💡 说明：货到后点击【一键入库】即可自动增加商品库存；支持点击右上角【🤖 AI 手写单拍照导入】智能识别进货单据。" 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" 
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Content="🔄 刷新列表" 
                            Command="{Binding LoadOrdersCommand}" 
                            Height="34" 
                            Padding="12,0"/>
                </Grid>
            </Border>

            <!-- 表头 -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="75"/>
                        <ColumnDefinition Width="230"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="采购单号" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="供货商" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="制单时间" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="品类数" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="采购总数" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="采购总额" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="单据状态" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="操作" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行与空状态提示 -->
            <Grid Grid.Row="2">
                <ListView ItemsSource="{Binding PurchaseOrders}" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1,0,1,1"
                          CornerRadius="0,0,8,8"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Grid.Column="0" Text="{Binding PurchaseOrderNo}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, Converter={StaticResource DateTimeFormatConverter}}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding TotalItemsCount}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding TotalQuantity}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#FF8C00" VerticalAlignment="Center"/>
                                
                                <!-- 状态彩色标签 -->
                                <Border Grid.Column="6" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        CornerRadius="4" 
                                        Padding="8,3"
                                        Background="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=Background}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}}" 
                                               FontSize="12" FontWeight="SemiBold" 
                                               Foreground="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=Foreground}"/>
                                </Border>

                                <!-- 操作按钮组 (根据状态智能显隐) -->
                                <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <!-- 一键入库：仅 Draft 状态可见 -->
                                    <Button Content="📦 一键入库" 
                                            Click="StockInButton_Click"
                                            Style="{StaticResource AccentButtonStyle}"
                                            Height="32" 
                                            Padding="10,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=DraftOnly}"/>

                                    <!-- 导出Excel：Draft 和 Received 状态可见 -->
                                    <Button Content="📑 导出Excel" 
                                            Click="ExportExcelButton_Click"
                                            Height="32" 
                                            Padding="10,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=NotCancelled}"/>

                                    <!-- 删除：仅 Draft 和 Cancelled 状态可见 -->
                                    <Button Content="🗑️" 
                                            Click="DeleteOrderButton_Click"
                                            Height="32" 
                                            Padding="8,0"
                                            Visibility="{Binding Status, Converter={StaticResource PurchaseOrderStatusConverter}, ConverterParameter=NotReceived}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 空状态友好提示面板 -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Spacing="12"
                            Visibility="{x:Bind GetEmptyOrdersVisibility(ViewModel.PurchaseOrders.Count), Mode=OneWay}">
                    <TextBlock Text="📋" FontSize="44" HorizontalAlignment="Center"/>
                    <TextBlock Text="暂无采购单记录" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="点击顶部【➕ 快速制作采购单】或【🤖 AI 手写单拍照导入】创建您的第一张采购单" 
                               FontSize="13" 
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- TAB 2: 新建采购单 (三栏式选品与制单工作台) -->
        <Grid x:Name="WorkbenchGrid" Grid.Row="1" Visibility="{x:Bind GetTab2Visibility(ViewModel.SelectedTabIndex), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CategoryColumn" Width="160" MinWidth="0"/>
                <ColumnDefinition x:Name="ProductColumn" Width="*" MinWidth="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition x:Name="CartColumn" Width="520" MinWidth="380"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：商品品类导航 -->
            <Border x:Name="CategoryBorder"
                    Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,10,0" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="4,4,4,12">
                        <TextBlock Text="🏷️ 商品品类" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button x:Name="CollapseCategoryBtn" 
                                Content="◀" 
                                HorizontalAlignment="Right" 
                                Height="28" Width="28" Padding="0"
                                ToolTipService.ToolTip="折叠品类列表，获得更大选品与制单空间"
                                Click="CollapseCategoryButton_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Style="{Binding Converter={StaticResource CategoryToStyleConverter}}"
                                            Click="CategoryButton_Click" 
                                            HorizontalAlignment="Stretch" 
                                            Height="38" 
                                            Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 中栏：商品浏览与选品数据表 -->
            <Grid Grid.Column="1" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 顶部搜索工具栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ExpandCategoryBtn" 
                                Content="🏷️ 展开品类" 
                                Visibility="Collapsed" 
                                Height="36" 
                                Click="ExpandCategoryButton_Click"
                                ToolTipService.ToolTip="重新展开左侧商品品类列表"/>
                        <TextBox PlaceholderText="🔍 搜索商品名称或条码 (回车)" 
                                 Width="230" 
                                 Height="36"
                                 Text="{Binding SearchProductKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                 KeyDown="SearchProductTextBox_KeyDown"/>
                        <Button Content="搜索" Command="{Binding SearchProductsCommand}" Height="36"/>
                        <Button Content="重置" Command="{Binding ResetProductSearchCommand}" Height="36"/>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="分类:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{Binding SelectedCategory}" FontSize="13" FontWeight="SemiBold" Foreground="#FF8C00"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="共" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                        <TextBlock Text="{Binding AvailableProductCount}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="件商品 (双击行或点【+采购】加入)" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Grid>

                <!-- 表头 -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="条码" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="商品名称" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="分类" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="进货价" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="库存" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="单位" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="供应商" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="操作" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 数据行 (虚拟化列表) -->
                <ListView Grid.Row="2" 
                          ItemsSource="{Binding AvailableProducts}" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1,0,1,1"
                          CornerRadius="0,0,8,8"
                          Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="40"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,8" DoubleTapped="ProductRow_DoubleTapped" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Barcode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding StoreCategory}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#FF8C00" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Stock}" FontWeight="Normal" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="5" Text="{Binding SaleUnit}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="6" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="7" 
                                        Content="+ 采购" 
                                        Click="AddProductToDraftButton_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Height="30" 
                                        Padding="8,0" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 动态调节分割条 (可左右拖拽自由调整待制采购单宽度) -->
            <Border x:Name="CartSplitter" 
                    Grid.Column="2" 
                    Width="12" 
                    Background="Transparent" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Stretch"
                    PointerEntered="CartSplitter_PointerEntered" 
                    PointerExited="CartSplitter_PointerExited" 
                    PointerPressed="CartSplitter_PointerPressed" 
                    PointerMoved="CartSplitter_PointerMoved" 
                    PointerReleased="CartSplitter_PointerReleased" 
                    PointerCaptureLost="CartSplitter_PointerCaptureLost" 
                    DoubleTapped="CartSplitter_DoubleTapped"
                    ToolTipService.ToolTip="按住左右拖动调节待制采购单宽度，双击恢复默认宽度">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Stretch">
                    <!-- 分割基准线 -->
                    <Border x:Name="SplitterBar" 
                            Width="2" 
                            CornerRadius="1" 
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Stretch" 
                            Margin="0,4"/>
                    <!-- 居中药丸抓手手柄 (Grip) -->
                    <Border x:Name="SplitterGrip" 
                            Width="6" 
                            Height="38" 
                            CornerRadius="3" 
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="3">
                            <Ellipse Width="2" Height="2" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <Ellipse Width="2" Height="2" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <Ellipse Width="2" Height="2" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右栏：待制采购单明细与保存 -->
            <Border Grid.Column="3" 
                    Margin="4,0,0,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部采购单表头信息录入 -->
                    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CartTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Border Background="{ThemeResource AccentFillColorDefaultBrush}" 
                                        CornerRadius="10" 
                                        Padding="8,2" 
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind GetCartBadgeVisibility(ViewModel.CartItems.Count), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.CartItems.Count, Mode=OneWay}" 
                                               FontSize="11" 
                                               FontWeight="Bold" 
                                               Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button x:Name="ToggleCartExpandBtn" 
                                        Content="↔ 宽屏" 
                                        Click="ToggleCartExpandButton_Click" 
                                        Height="30" 
                                        Padding="8,0"
                                        FontSize="12"
                                        ToolTipService.ToolTip="一键切换【宽屏/紧凑】制单布局，亦可直接拖拽左侧分割条"/>
                                <Button Content="🤖 AI 识单导入" 
                                        Command="{Binding ImportFromAiCommand}" 
                                        Height="30" 
                                        Padding="10,0"
                                        FontSize="12"
                                        ToolTipService.ToolTip="拍照或手写单据，粘贴识别一键导入"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Header="供货商名称:" 
                                 PlaceholderText="例如：广州博美美发用品有限公司" 
                                 Text="{Binding SupplierInput, Mode=TwoWay}"/>
                        <TextBox Header="采购备注:" 
                                 PlaceholderText="例如：加急发货 / 纸箱包装" 
                                 Text="{Binding RemarkInput, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- 中部已选采购明细 -->
                    <ListView Grid.Row="1" 
                              ItemsSource="{Binding CartItems}" 
                              SelectionMode="None"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              Margin="0,0,0,10">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="10,8" 
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding ProductName}" 
                                                       FontWeight="SemiBold" 
                                                       FontSize="13" 
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTipService.ToolTip="{Binding ProductName}"/>
                                            <TextBlock Text="{Binding Barcode}" 
                                                       FontSize="11" 
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       ToolTipService.ToolTip="{Binding Barcode}"/>
                                        </StackPanel>

                                        <!-- 采购单价 -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="进价 (元):" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBox Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Height="28" Width="72" HorizontalAlignment="Left"
                                                     TextChanged="DraftCostPriceTextBox_TextChanged"
                                                     LostFocus="DraftCostPriceTextBox_LostFocus"
                                                     KeyDown="DraftNumericTextBox_KeyDown"/>
                                        </StackPanel>

                                        <!-- 数量操作 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" HorizontalAlignment="Center">
                                            <Button Content="-" Click="DecreaseDraftQuantityButton_Click" Height="28" Width="26" Padding="0"/>
                                            <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="50" Height="28" TextAlignment="Center" Padding="2,0"
                                                     TextChanged="DraftQuantityTextBox_TextChanged"
                                                     LostFocus="DraftQuantityTextBox_LostFocus"
                                                     KeyDown="DraftNumericTextBox_KeyDown"/>
                                            <Button Content="+" Click="IncreaseDraftQuantityButton_Click" Height="28" Width="26" Padding="0"/>
                                        </StackPanel>

                                        <!-- 小计 -->
                                        <TextBlock Grid.Column="3" Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="13" Foreground="#FF8C00" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,6,0"/>

                                        <Button Grid.Column="4" Content="🗑️" Click="RemoveDraftItemButton_Click" Height="28" Padding="6,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 底部汇总与创建按钮 -->
                    <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Padding="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="品类数:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CartItems.Count}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text=" | 总件数:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,0,0,0"/>
                                    <TextBlock Text="{Binding DraftTotalQuantity}" FontSize="15" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="总额:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding DraftTotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#FF8C00"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="1.4*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="清空重填" Command="{Binding ClearDraftCommand}" Height="40" HorizontalAlignment="Stretch"/>
                                <Button Grid.Column="1" Content="💾 生成采购单" 
                                        Click="CreatePurchaseOrderButton_Click" 
                                        Style="{StaticResource AccentButtonStyle}" 
                                        Height="40" 
                                        HorizontalAlignment="Stretch"
                                        FontSize="14" 
                                        FontWeight="Bold"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
