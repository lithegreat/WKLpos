<Page
    x:Class="WanKePos.WinUI.Views.ProductListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:WanKePos.WinUI.Controls"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Padding="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- WinUI Gallery 标准标头 -->
        <controls:PageHeader Grid.Row="0"
                             Title="商品档案管理" 
                             Description="集中管理店内商品条码、品类划分、零售价格与库存警戒" 
                             Glyph="&#xE7B8;"
                             BadgeText="快捷键 F2">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Command="{Binding AddProductCommand}" 
                        Style="{StaticResource AccentButtonStyle}"
                        Height="36" 
                        Padding="16,0" 
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13"/>
                        <TextBlock Text="新增商品" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ImportFromExcelCommand}" 
                        Height="36" 
                        Padding="14,0"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                        <TextBlock Text="导入 Excel" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏：品类导航 (WinUI Gallery 侧栏导航风格) -->
            <Border Grid.Column="0" 
                    Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="0,0,12,0" 
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="6,4,4,12">
                        <FontIcon Glyph="&#xE8EC;" FontSize="15" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="商品品类" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="CategoryItemsControl" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemContainerTransitions>
                                <TransitionCollection>
                                    <EntranceThemeTransition FromVerticalOffset="20" IsStaggeringEnabled="True"/>
                                    <RepositionThemeTransition/>
                                </TransitionCollection>
                            </ItemsControl.ItemContainerTransitions>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" 
                                            Click="CategoryButton_Click" 
                                            Style="{StaticResource CategoryItemButtonStyle}"
                                            Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右栏：商品管理列表与工具栏 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 搜索栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox PlaceholderText="搜索商品名称或条码 (回车)" 
                                 Width="280" 
                                 Height="36"
                                 Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchTextBox_KeyDown"/>
                        <Button Command="{Binding SearchCommand}" Height="36" Padding="14,0" CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="12"/>
                                <TextBlock Text="搜索" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <!-- 当前分类指示胶囊 (带切换弹性微动效) -->
                        <Border x:Name="CurrentCategoryBadge"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="10,3"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <CompositeTransform x:Name="CategoryBadgeTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Resources>
                                <Storyboard x:Name="CategoryBadgePulseStoryboard">
                                    <DoubleAnimation Storyboard.TargetName="CategoryBadgeTransform"
                                                     Storyboard.TargetProperty="ScaleX"
                                                     From="0.86" To="1.0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="CategoryBadgeTransform"
                                                     Storyboard.TargetProperty="ScaleY"
                                                     From="0.86" To="1.0" Duration="0:0:0.25">
                                        <DoubleAnimation.EasingFunction>
                                            <BackEase Amplitude="0.35" EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Border.Resources>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8EC;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="当前分类:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="{Binding SelectedCategory}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PriceHighlightBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 表头 (WinUI Gallery 表格风格) -->
                <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="条码" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="商品名称" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="店内品类" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="零售售价" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="进货成本" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="会员特价" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="库存" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="单位" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="状态" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="9" Text="供应商" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="10" Text="操作" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- 数据行 (虚拟化列表 + 切换分类流畅过渡) -->
                <Grid Grid.Row="2">
                    <Grid.Resources>
                        <Storyboard x:Name="ProductTableEntranceStoryboard">
                            <DoubleAnimation Storyboard.TargetName="ProductTableTranslate"
                                             Storyboard.TargetProperty="Y"
                                             From="14" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="ProductListView"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0.3" To="1" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </Grid.Resources>
                    <ListView x:Name="ProductListView"
                              ItemsSource="{Binding Products}" 
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1,0,1,1"
                              CornerRadius="0,0,8,8"
                              Padding="0"
                              DoubleTapped="ProductListView_DoubleTapped">
                        <ListView.RenderTransform>
                            <TranslateTransform x:Name="ProductTableTranslate" Y="0"/>
                        </ListView.RenderTransform>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <EntranceThemeTransition FromVerticalOffset="16" IsStaggeringEnabled="True"/>
                                <RepositionThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="40"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,8">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="编辑商品" Click="EditProductMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70F;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="删除商品" Click="DeleteProductMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource CriticalTextBrush}"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="65"/>
                                        <ColumnDefinition Width="45"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="95"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Barcode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding StoreCategory}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="3" Text="{Binding RetailPrice, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="{ThemeResource PriceHighlightBrush}" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBlock Grid.Column="4" Text="{Binding CostPrice, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
                                    <TextBlock Grid.Column="5" Text="{Binding MemberPrice, Converter={StaticResource CurrencyConverter}}" Foreground="{ThemeResource SuccessTextBrush}" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="6" Text="{Binding Stock}" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
                                    <TextBlock Grid.Column="7" Text="{Binding SaleUnit}" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="8" Text="{Binding ShelfStatus}" VerticalAlignment="Center" FontSize="12"/>
                                    <TextBlock Grid.Column="9" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <!-- 操作按钮 -->
                                    <StackPanel Grid.Column="10" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Click="EditProductButton_Click"
                                                Height="28" 
                                                Padding="8,0" 
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="编辑修改商品">
                                            <FontIcon Glyph="&#xE70F;" FontSize="11" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                        </Button>
                                        <Button Click="DeleteProductButton_Click"
                                                Height="28" 
                                                Padding="8,0" 
                                                CornerRadius="4"
                                                ToolTipService.ToolTip="删除商品档案">
                                            <FontIcon Glyph="&#xE74D;" FontSize="11" Foreground="{ThemeResource CriticalTextBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
