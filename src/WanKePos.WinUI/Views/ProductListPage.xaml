<Page
    x:Class="WanKePos.WinUI.Views.ProductListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：品类导航 -->
        <Border Grid.Column="0" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="0,0,12,0" 
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🏷️ 商品品类" FontSize="16" FontWeight="SemiBold" Margin="4,4,4,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" 
                                        Click="CategoryButton_Click" 
                                        HorizontalAlignment="Stretch" 
                                        Height="38" 
                                        Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右栏：商品管理列表与工具栏 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- 搜索与操作栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBox PlaceholderText="🔍 搜索商品名称或条码 (回车)" 
                             Width="280" 
                             Text="{Binding SearchKeyword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_KeyDown"/>
                    <Button Content="搜索" Command="{Binding SearchCommand}"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="当前分类:" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{Binding SelectedCategory}" FontSize="13" FontWeight="SemiBold" Foreground="#FF8C00"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="➕ 新增商品" 
                            Command="{Binding AddProductCommand}" 
                            Style="{StaticResource AccentButtonStyle}"
                            Height="38" 
                            Padding="16,0" 
                            FontWeight="Bold"/>
                    <Button Content="📂 导入Excel" 
                            Command="{Binding ImportFromExcelCommand}" 
                            Height="38" 
                            Padding="14,0"/>
                </StackPanel>
            </Grid>

            <!-- 表头 -->
            <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="条码" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="商品名称" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="店内品类" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="零售售价" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="进货成本" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" Text="会员特价" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="6" Text="库存" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="7" Text="单位" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="8" Text="状态" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="9" Text="供应商" FontWeight="Bold" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 数据行 (虚拟化列表) -->
            <ListView Grid.Row="2" 
                      ItemsSource="{Binding Products}" 
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionMode="None"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1,0,1,1"
                      CornerRadius="0,0,8,8"
                      Padding="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Barcode}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding StoreCategory}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding RetailPrice}" FontWeight="Bold" Foreground="#FF8C00" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding CostPrice}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="5" Text="{Binding MemberPrice}" Foreground="LightGreen" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding Stock}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="{Binding SaleUnit}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{Binding ShelfStatus}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="{Binding Supplier}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
