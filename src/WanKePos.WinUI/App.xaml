<Application
    x:Class="WanKePos.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:WanKePos.WinUI.Converters"
    xmlns:local="using:WanKePos.WinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局通用转换器 -->
            <converters:DecimalToCurrencyConverter x:Key="CurrencyConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:PurchaseOrderStatusConverter x:Key="PurchaseOrderStatusConverter"/>
            <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter"/>
            <converters:CategoryToStyleConverter x:Key="CategoryToStyleConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
