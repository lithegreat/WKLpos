<ui:FluentWindow x:Class="WanKePos.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WanKePos.App"
        Title="万客隆 POS 收银系统" Height="768" Width="1024" WindowState="Maximized"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <ui:NavigationView x:Name="RootNavigation"
                           PaneTitle="菜单"
                           IsBackButtonVisible="Collapsed"
                           Grid.Row="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="收银台" Icon="{ui:SymbolIcon Symbol=Cart24}" TargetPageType="{x:Type local:Views.CashierView}" />
                <ui:NavigationViewItem Content="商品管理" Icon="{ui:SymbolIcon Symbol=Box24}" TargetPageType="{x:Type local:Views.ProductListView}" />
                <ui:NavigationViewItem Content="会员管理" Icon="{ui:SymbolIcon Symbol=People24}" TargetPageType="{x:Type local:Views.MemberListView}" />
                <ui:NavigationViewItem Content="销售记录" Icon="{ui:SymbolIcon Symbol=Receipt24}" TargetPageType="{x:Type local:Views.OrderHistoryView}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="系统设置" Icon="{ui:SymbolIcon Symbol=Settings24}" TargetPageType="{x:Type local:Views.SettingsView}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Row="1" Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentStoreName}" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding SyncStatusText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding CurrentTime}" VerticalAlignment="Center" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
