<ui:FluentWindow x:Class="WanKePos.App.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="🚀 发现新版本更新" Height="480" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="Assets/pos_icon.ico"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- 版本概览卡片 -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="最新版本: " FontSize="15" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionTextBlock" Text="v1.0.1" FontSize="16" FontWeight="Bold" Foreground="#FF8C00"/>
                            <TextBlock x:Name="CurrentVersionTextBlock" Text=" (当前: v1.0.0)" FontSize="12" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="安装包大小: " Foreground="#A0A0A0" FontSize="12"/>
                            <TextBlock x:Name="SizeTextBlock" Text="38.5 MB" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <TextBlock Text="发布时间: " Foreground="#A0A0A0" FontSize="12"/>
                            <TextBlock x:Name="DateTextBlock" Text="2026-09-03" FontSize="12" Foreground="#A0A0A0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 更新日志 -->
                <TextBlock Text="📋 更新内容说明:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <Border Background="#10FFFFFF" CornerRadius="6" Padding="10" Margin="0,0,0,12" MaxHeight="160">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesTextBlock" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                    </ScrollViewer>
                </Border>

                <!-- 下载进度条区 -->
                <StackPanel x:Name="ProgressPanel" Margin="0,0,0,8" Visibility="Collapsed">
                    <Grid Margin="0,0,0,4">
                        <TextBlock x:Name="ProgressStatusText" Text="正在下载新版本安装程序..." FontSize="12"/>
                        <TextBlock x:Name="ProgressPercentText" Text="0%" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF8C00"/>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgressBar" Value="0" Maximum="100" Height="8"/>
                </StackPanel>

                <!-- 错误提示 -->
                <TextBlock x:Name="ErrorTextBlock" Foreground="Red" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button x:Name="CancelButton" Content="稍后提醒" Click="CancelButton_Click" Margin="0,0,10,0" Width="90"/>
            <ui:Button x:Name="DownloadButton" Content="立即下载并安装" Appearance="Primary" Click="DownloadButton_Click" Width="130" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
