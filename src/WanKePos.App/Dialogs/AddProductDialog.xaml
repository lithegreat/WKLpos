<ui:FluentWindow x:Class="WanKePos.App.Dialogs.AddProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="➕ 手动新增商品" Height="580" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- 条码 -->
                <TextBlock Text="商品条码 / 简码 *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="BarcodeTextBox" PlaceholderText="支持扫码枪扫入或手动输入"/>
                    <ui:Button Grid.Column="1" Content="⚡ 自动生成" Click="GenerateBarcodeButton_Click" Margin="8,0,0,0"/>
                </Grid>

                <!-- 名称 -->
                <TextBlock Text="商品名称 *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="NameTextBox" PlaceholderText="例如：施华蔻炫彩染膏 60ml" Margin="0,0,0,12"/>

                <!-- 分类与售卖方式 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="店内分类" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryComboBox" IsEditable="True" Height="36"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="售卖方式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SaleMethodComboBox" SelectedIndex="0" Height="36">
                            <ComboBoxItem Content="按件售卖"/>
                            <ComboBoxItem Content="称重售卖"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- 价格与库存区域 -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,6,8">
                            <TextBlock Text="门店零售价 *" Foreground="#FF8C00" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="RetailPriceTextBox" PlaceholderText="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="3,0,3,8">
                            <TextBlock Text="进货成本价" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="CostPriceTextBox" PlaceholderText="0.00"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="6,0,0,8">
                            <TextBlock Text="会员特价" Foreground="LightGreen" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="MemberPriceTextBox" PlaceholderText="选填"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="初始库存" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="StockTextBox" Text="100"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="3,0,3,0">
                            <TextBlock Text="销售单位" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="SaleUnitTextBox" Text="支"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="6,0,0,0">
                            <TextBlock Text="规格/净含量" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="SpecTextBox" PlaceholderText="如: 60ml"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 供应商与品牌 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="供应商名称" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="SupplierTextBox" PlaceholderText="例如：博美美发用品"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="商品品牌" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="BrandTextBox" PlaceholderText="例如：施华蔻"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorTextBlock" Foreground="Red" Margin="0,0,0,8" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="取消" Click="CancelButton_Click" Margin="0,0,10,0" Width="80"/>
            <ui:Button Content="保存并上架" Appearance="Primary" Click="SaveButton_Click" Width="110" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
