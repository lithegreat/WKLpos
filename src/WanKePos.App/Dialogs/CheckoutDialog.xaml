<Window x:Class="WanKePos.App.Dialogs.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="结算确认" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding Title}" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- 应付金额 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="应付金额" FontSize="14" HorizontalAlignment="Center" 
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="PayableText" FontSize="36" FontWeight="Bold" 
                       Foreground="#FF8C00" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- 实收金额输入 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="实收金额:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="PaidAmountTextBox" FontSize="24" Height="48" 
                     HorizontalContentAlignment="Center" TextChanged="PaidAmountTextBox_TextChanged"/>
        </StackPanel>

        <!-- 找零显示 -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0">
            <TextBlock Text="找零:" FontSize="14" HorizontalAlignment="Center"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            <TextBlock x:Name="ChangeText" FontSize="28" FontWeight="Bold" 
                       Foreground="LightGreen" HorizontalAlignment="Center" Text="¥0.00"/>
        </StackPanel>

        <!-- 按钮 -->
        <UniformGrid Grid.Row="4" Columns="2">
            <ui:Button Content="取消" Appearance="Secondary" Height="48" FontSize="16" 
                       Margin="0,0,5,0" Click="Cancel_Click"/>
            <ui:Button x:Name="ConfirmButton" Content="确认结算" Appearance="Primary" Height="48" FontSize="16" 
                       Margin="5,0,0,0" Click="Confirm_Click" IsEnabled="False"/>
        </UniformGrid>
    </Grid>
</Window>
