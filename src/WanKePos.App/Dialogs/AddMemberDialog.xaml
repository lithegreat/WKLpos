<ui:FluentWindow x:Class="WanKePos.App.Dialogs.AddMemberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="➕ 办理新会员 / 新增会员" Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- 手机号 -->
                <TextBlock Text="会员手机号 *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="PhoneTextBox" PlaceholderText="输入11位手机号 (必填)" Margin="0,0,0,12"/>

                <!-- 姓名与会员卡号 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="会员姓名 *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="NameTextBox" PlaceholderText="例如：王女士"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="会员卡号" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="MemberNoTextBox" PlaceholderText="自动生成"/>
                            <ui:Button Grid.Column="1" Content="⚡" Click="GenerateMemberNoButton_Click" Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 性别与生日 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="会员性别" Margin="0,0,0,4"/>
                        <ComboBox x:Name="GenderComboBox" SelectedIndex="0" Height="36">
                            <ComboBoxItem Content="女士"/>
                            <ComboBoxItem Content="先生"/>
                            <ComboBoxItem Content="保密"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="会员生日" Margin="0,0,0,4"/>
                        <DatePicker x:Name="BirthdayPicker" Height="36"/>
                    </StackPanel>
                </Grid>

                <!-- 储值余额与初始积分 -->
                <Border Background="#15FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="开卡储值余额 (元)" Foreground="LightGreen" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="BalanceTextBox" Text="0.00"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="初始积分" Foreground="#FF8C00" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="PointsTextBox" Text="0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 会员身份与专属导购 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                        <TextBlock Text="会员身份 / 等级" Margin="0,0,0,4"/>
                        <ComboBox x:Name="IdentityComboBox" SelectedIndex="0" Height="36">
                            <ComboBoxItem Content="普通会员"/>
                            <ComboBoxItem Content="黄金会员"/>
                            <ComboBoxItem Content="钻石VIP"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                        <TextBlock Text="专属导购 / 发型师" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="GuideNameTextBox" PlaceholderText="例如：Andy老师"/>
                    </StackPanel>
                </Grid>

                <!-- 住址 -->
                <TextBlock Text="家庭住址 / 备注" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="AddressTextBox" PlaceholderText="选填" Margin="0,0,0,8"/>

                <TextBlock x:Name="ErrorTextBlock" Foreground="Red" Margin="0,0,0,8" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <ui:Button Content="取消" Click="CancelButton_Click" Margin="0,0,10,0" Width="80"/>
            <ui:Button Content="确认开卡" Appearance="Primary" Click="SaveButton_Click" Width="100" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
