<Page x:Class="WanKePos.App.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="设置">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            
            <TextBlock Text="门店信息" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="门店名称" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.StoreName}" Margin="0,0,0,10"/>
                    <TextBlock Text="门店地址" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.StoreAddress}" Margin="0,0,0,10"/>
                    <TextBlock Text="联系电话" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.StorePhone}"/>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="打印机设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="打印机端口" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding Settings.PrinterPort}" Margin="0,0,0,10"/>
                    <TextBlock Text="波特率" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.PrinterBaudRate}" Margin="0,0,0,10"/>
                    <ui:Button Content="测试打印" Command="{Binding TestPrintCommand}"/>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="积分规则" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="每消费1元获得积分数" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.PointsPerYuan}"/>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="小票设置" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="小票抬头" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.ReceiptHeader}" AcceptsReturn="True" Height="60" Margin="0,0,0,10"/>
                    <TextBlock Text="小票结尾" Margin="0,0,0,5"/>
                    <ui:TextBox Text="{Binding Settings.ReceiptFooter}" AcceptsReturn="True" Height="60"/>
                </StackPanel>
            </ui:CardControl>

            <TextBlock Text="数据管理" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <ui:CardControl Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="导入商品库" Command="{Binding ImportProductsCommand}" Margin="0,0,10,0"/>
                    <ui:Button Content="导入会员库" Command="{Binding ImportMembersCommand}"/>
                </StackPanel>
            </ui:CardControl>

            <ui:Button Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Appearance="Primary" Height="40" Padding="20,0"/>

        </StackPanel>
    </ScrollViewer>
</Page>
