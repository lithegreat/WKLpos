<Page x:Class="WanKePos.App.Views.OrderHistoryView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:WanKePos.App.Converters"
      Title="订单历史">
    <Page.Resources>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ui:CardControl Grid.Column="0" Margin="5" BorderBrush="Green" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="今日销售额" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding Summary.TotalSales, Converter={StaticResource DecimalToCurrencyConverter}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Grid.Column="1" Margin="5" BorderBrush="Blue" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="订单数" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding Summary.OrderCount}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Grid.Column="2" Margin="5" BorderBrush="Orange" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="今日毛利" FontSize="12" Foreground="Gray" />
                    <TextBlock Text="{Binding Summary.TotalProfit, Converter={StaticResource DecimalToCurrencyConverter}}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </ui:CardControl>
            <ui:Button Grid.Column="3" Content="刷新" Command="{Binding RefreshCommand}" Margin="10,5,5,5" VerticalAlignment="Center" />
        </Grid>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Orders}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#1AFFFFFF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="订单号" Binding="{Binding OrderNo}" />
                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" />
                <DataGridTextColumn Header="会员" Binding="{Binding MemberName}" />
                <DataGridTextColumn Header="金额" Binding="{Binding PayableAmount, Converter={StaticResource DecimalToCurrencyConverter}}" />
                <DataGridTextColumn Header="支付方式" Binding="{Binding PaymentMethod}" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
