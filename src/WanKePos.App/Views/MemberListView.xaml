<Page x:Class="WanKePos.App.Views.MemberListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:WanKePos.App.Converters"
      Title="会员管理">
    <Page.Resources>
        <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <ui:TextBox PlaceholderText="搜索会员名称、手机或编号..." Width="250" Margin="0,0,10,0" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button Content="搜索" Command="{Binding SearchCommand}" Margin="0,0,10,0" />
            <ui:Button Content="导入Excel" Command="{Binding ImportFromExcelCommand}" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Members}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#1AFFFFFF">
            <DataGrid.Columns>
                <DataGridTextColumn Header="编号" Binding="{Binding MemberNo}" />
                <DataGridTextColumn Header="手机号" Binding="{Binding Phone}" />
                <DataGridTextColumn Header="姓名" Binding="{Binding Name}" />
                <DataGridTextColumn Header="性别" Binding="{Binding Gender}" />
                <DataGridTextColumn Header="积分" Binding="{Binding TotalPoints}" />
                <DataGridTextColumn Header="余额" Binding="{Binding Balance, Converter={StaticResource DecimalToCurrencyConverter}}" />
                <DataGridTextColumn Header="累计消费" Binding="{Binding TotalSpent, Converter={StaticResource DecimalToCurrencyConverter}}" />
                <DataGridTextColumn Header="状态" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
