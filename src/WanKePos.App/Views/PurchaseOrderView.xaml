<Page x:Class="WanKePos.App.Views.PurchaseOrderView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:WanKePos.App.Converters"
      Title="采购进货">
    <Page.Resources>
        <converters:DecimalToCurrencyConverter x:Key="CurrencyConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}">
            <!-- TAB 1: 采购单列表与入库 -->
            <TabItem Header="📋 采购单记录与入库">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#15FFFFFF" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="💡 说明：货到后点击【一键入库】即可自动增加商品库存；点击【导出Excel】可生成专业订货单发给供货商。" 
                                       Foreground="#A0A0A0" VerticalAlignment="Center"/>
                            <ui:Button Content="🔄 刷新列表" Command="{Binding LoadOrdersCommand}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding PurchaseOrders}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#1AFFFFFF"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="采购单号" Binding="{Binding PurchaseOrderNo}" Width="190"/>
                            <DataGridTextColumn Header="供货商" Binding="{Binding Supplier}" Width="140"/>
                            <DataGridTextColumn Header="制单时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140"/>
                            <DataGridTextColumn Header="品类数" Binding="{Binding TotalItemsCount}" Width="80"/>
                            <DataGridTextColumn Header="采购总数" Binding="{Binding TotalQuantity}" Width="90"/>
                            <DataGridTextColumn Header="采购总额" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="110"/>
                            <DataGridTextColumn Header="单据状态" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="📦 一键入库" 
                                                       Click="StockInButton_Click" 
                                                       Margin="0,0,6,0" 
                                                       Padding="8,4" 
                                                       FontSize="12"/>
                                            <ui:Button Content="📑 导出Excel" 
                                                       Click="ExportExcelButton_Click" 
                                                       Margin="0,0,6,0" 
                                                       Padding="8,4" 
                                                       FontSize="12"/>
                                            <ui:Button Content="🗑️" 
                                                       Click="DeleteButton_Click" 
                                                       Padding="6,4" 
                                                       FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: 新建采购单 -->
            <TabItem Header="➕ 快速制作采购单">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：商品选择库 -->
                    <Border Grid.Column="0" Background="#15FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="📦 选择采购商品" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                            
                            <ui:TextBox Grid.Row="1" 
                                        PlaceholderText="搜索商品名称或条码..." 
                                        Text="{Binding SearchProductKeyword, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,8">
                                <ui:TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchProductsCommand}"/>
                                </ui:TextBox.InputBindings>
                            </ui:TextBox>

                            <ListView Grid.Row="2" ItemsSource="{Binding AvailableProducts}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#20FFFFFF" CornerRadius="6" Padding="10,6" Margin="0,0,0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CostPrice, StringFormat='进价: ¥{0:F2}'}" FontSize="11" Foreground="#FF8C00"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat='库存: {0}'}" Foreground="#A0A0A0" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>

                                                <ui:Button Grid.Column="2" Content="+ 加入" Click="AddProductButton_Click" Padding="8,2" FontSize="12"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- 右侧：采购清单录入 -->
                    <Border Grid.Column="1" Background="#15FFFFFF" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 表头信息 -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0" PlaceholderText="供货商名称 (例如: 广州博美用品)" Text="{Binding SupplierInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0"/>
                                <ui:TextBox Grid.Column="1" PlaceholderText="采购备注 (例如: 加急发货)" Text="{Binding RemarkInput, UpdateSourceTrigger=PropertyChanged}" Margin="6,0,0,0"/>
                            </Grid>

                            <!-- 明细表格 -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" AlternatingRowBackground="#1AFFFFFF">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="160" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="进价 (元)" Binding="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                                    <DataGridTextColumn Header="采购数量" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    <DataGridTextColumn Header="小计金额" Binding="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}" Width="100" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="🗑️" Click="RemoveDraftItemButton_Click" Padding="6,2" FontSize="12"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 底部汇总 -->
                            <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#30FFFFFF" Padding="0,10,0,0" Margin="0,10,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="采购总数: " FontSize="14" Foreground="#A0A0A0"/>
                                        <TextBlock Text="{Binding DraftTotalQuantity}" FontSize="16" FontWeight="Bold" Margin="0,0,20,0"/>
                                        <TextBlock Text="采购总金额: " FontSize="14" Foreground="#A0A0A0"/>
                                        <TextBlock Text="{Binding DraftTotalAmount, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#FF8C00"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <ui:Button Content="清空重填" Command="{Binding ClearDraftCommand}" Margin="0,0,10,0" Padding="14,6"/>
                                        <ui:Button Content="💾 生成采购单" Command="{Binding CreatePurchaseOrderCommand}" Appearance="Primary" Padding="20,6" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
